# App
NODE_ENV=development
PORT=3000

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:5173

# Database (SQLite file path)
DB_PATH=./data/app.db

# Auth — use a strong random string in production (e.g. openssl rand -hex 32)
JWT_SECRET=change-this-to-a-strong-random-secret

# Ollama (local LLM)
# Use http://localhost:11434 when running API directly on host
# Use http://host.docker.internal:11434 when API runs inside Docker Desktop
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Emergency Controls (admin dashboard — stop registration, maintenance mode, freeze classes)
# Use a strong password in production
EMERGENCY_PASSWORD=

# Sentry (optional — leave empty to disable)
# Get DSN from https://sentry.io or self-hosted instance
VITE_SENTRY_DSN=

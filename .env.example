# ─────────────────────────────────────────────────────────────────────
# Feras — Environment Variables Reference (NAMES ONLY, no secrets)
#
# Local setup: copy this file to `.env` and fill real values.
# Vercel setup: add the same variable NAMES in
#   Project Settings → Environment Variables (Production/Preview/Development).
#
# ⚠️ Never commit real `.env` / `.env.local` files — they are gitignored.
# ─────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────
# application environment: development | production | test
NODE_ENV=
# API HTTP port (defaults to 3000 locally)
PORT=
# set to 1 to skip starting the HTTP server (used by e2e tests)
SKIP_SERVE=

# ── Web Frontend (Vite — replaced at build time) ────────────────────
# API base URL the browser will call — the FULL URL of the deployed API host
# (e.g. https://your-api.railway.app). The Vercel frontend domain goes in
# CORS_ORIGIN on the API side, not here.
VITE_API_BASE_URL=
# Sentry DSN for the browser bundle (optional)
VITE_SENTRY_DSN=

# ── CORS / Security ─────────────────────────────────────────────────
# Comma-separated list of allowed browser origins. In production set
# ONLY your live Vercel frontend domain, e.g.
#   CORS_ORIGIN=https://your-app.vercel.app
CORS_ORIGIN=
# IPs/CIDRs of reverse proxies allowed to provide x-forwarded-for headers
TRUSTED_PROXIES=
# Max request body size in bytes (defaults to 1MB)
MAX_BODY_SIZE=

# ── Database ────────────────────────────────────────────────────────
# SQLite file path (local/self-hosted). This project does NOT use
# DATABASE_URL — the API reads DB_PATH only.
DB_PATH=

# ── Auth / JWT ──────────────────────────────────────────────────────
# REQUIRED. Strong random string in production (e.g. openssl rand -hex 32)
JWT_SECRET=

# ── Admin seed (set on first run only, then remove) ─────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Emergency Controls password (admin dashboard — stop registration, maintenance mode, freeze classes)
EMERGENCY_PASSWORD=

# ── Email (Resend.com — get API key from https://resend.com/api-keys)
RESEND_API_KEY=
FROM_EMAIL=
APP_NAME=
APP_URL=

# ── Sentry (optional — leave empty to disable) ──────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_PROFILES_SAMPLE_RATE=

# ── Cloud Backup (Cloudflare R2 or any S3-compatible storage — optional) ──
# R2: https://developers.cloudflare.com/r2/api/s3/tokens/
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: custom endpoint (defaults to https://{ACCOUNT_ID}.r2.cloudflarestorage.com)
R2_ENDPOINT=
# Local backup retention (optional)
BACKUP_DIR=
MAX_BACKUPS=

# ── Telegram (optional — for complaint notifications) ───────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── AI / Translation (Ollama — optional) ────────────────────────────
# Use http://localhost:11434 when running API directly on host
# Use http://host.docker.internal:11434 when API runs inside Docker Desktop
OLLAMA_URL=
OLLAMA_MODEL=
# Ollama model used for Arabic translation
OLLAMA_TRANSLATION_MODEL=

# ── Localization ────────────────────────────────────────────────────
DEFAULT_LOCALE=


# App
NODE_ENV=development
PORT=3000

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:5173

# Database (SQLite file path)
DB_PATH=./data/app.db

# Auth — use a strong random string in production (e.g. openssl rand -hex 32)
JWT_SECRET=change-this-to-a-strong-random-secret

# Ollama (local LLM)
# Use http://localhost:11434 when running API directly on host
# Use http://host.docker.internal:11434 when API runs inside Docker Desktop
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Emergency Controls (admin dashboard — stop registration, maintenance mode, freeze classes)
# Use a strong password in production
EMERGENCY_PASSWORD=

# Sentry (optional — leave empty to disable)
# Get DSN from https://sentry.io or self-hosted instance
VITE_SENTRY_DSN=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Email (Resend.com — get API key from https://resend.com/api-keys)
RESEND_API_KEY=
FROM_EMAIL=no-reply@resend.dev
APP_NAME=منصة العلوم
APP_URL=http://localhost:5173

# Admin seed (set on first run, then remove or leave)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloud Backup (Cloudflare R2 or any S3-compatible storage — leave empty to disable)
# R2: https://developers.cloudflare.com/r2/api/s3/tokens/
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=db-backups
# Optional: custom endpoint (defaults to https://{ACCOUNT_ID}.r2.cloudflarestorage.com)
R2_ENDPOINT=

# ─────────────────────────────────────────────────────────────────────
# API — Environment Variables Reference (NAMES ONLY, no secrets)
# Copy to `.env` locally / add in Vercel Project Settings.
# ─────────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# set to 1 to skip starting the HTTP server (used by e2e tests)
SKIP_SERVE=

# ── Database ────────────────────────────────────────────────────────
DB_PATH=

# ── Security ────────────────────────────────────────────────────────
# REQUIRED in production (strong random string, e.g. openssl rand -hex 32)
JWT_SECRET=
# IPs/CIDRs of reverse proxies allowed to provide x-forwarded-for headers
TRUSTED_PROXIES=
# Max request body size in bytes (defaults to 1MB)
MAX_BODY_SIZE=

# ── CORS ────────────────────────────────────────────────────────────
# Production: set to your live Vercel frontend domain ONLY,
# e.g. CORS_ORIGIN=https://your-app.vercel.app
# Dev: add http://localhost:5173 as needed.
CORS_ORIGIN=

# ── Admin seed (set on first run only, then remove) ─────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
EMERGENCY_PASSWORD=

# ── Email (Resend.com) ──────────────────────────────────────────────
RESEND_API_KEY=
FROM_EMAIL=
APP_NAME=
APP_URL=

# ── Sentry (optional) ───────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_PROFILES_SAMPLE_RATE=

# ── Cloud Backup (Cloudflare R2 / S3-compatible — optional) ─────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
BACKUP_DIR=
MAX_BACKUPS=

# ── Telegram (optional) ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── AI / Translation (Ollama — optional) ────────────────────────────
OLLAMA_URL=
OLLAMA_MODEL=
OLLAMA_TRANSLATION_MODEL=

# ── Localization ────────────────────────────────────────────────────
DEFAULT_LOCALE=

      "result": "<script setup lang=\"ts\">\nimport type { RcCircuitTrial } from '../../../composables/rc-circuit/useRcCircuitTrials'\n\ninterface Props { id: string; trials: RcCircuitTrial[]; params: { R: number; C: number; V0: number; mode: 'charge' | 'discharge' }; currentV: number; tau: number; simTime: number }\ndefineProps<Props>()\nconst emit = defineEmits<{\n  (e: 'remove', id: number): void\n  (e: 'clear'): void\n  (e: 'update:params', p: { R: number; C: number; V0: number; mode: 'charge' | 'discharge' }): void\n}>()\n</script>\n<template>\n  <div>\n    <div v-if=\"id === 'readings'\" class=\"panel-body\">\n      <div class=\"read-row\"><span class=\"label\">R</span><span class=\"value\">{{ params.R }} Ω</span></div>\n      <div class=\"read-row\"><span class=\"label\">C</span><span class=\"value\">{{ (params.C*1000).toFixed(0) }} μF</span></div>\n      <div class=\"read-row\"><span class=\"label\">V₀</span><span class=\"value\">{{ params.V0 }} V</span></div>\n      <div class=\"read-row\"><span class=\"label\">τ</span><span class=\"value\">{{ tau.toFixed(3) }} s</span></div>\n      <div class=\"read-row\"><span class=\"label\">V</span><span class=\"value\">{{ currentV.toFixed(2) }} V</span></div>\n      <div class=\"read-row\"><span class=\"label\">t</span><span class=\"value\">{{ simTime.toFixed(2) }} s</span></div>\n      <div class=\"read-row\"><span class=\"label\">الوضع</span><span class=\"value\">{{ params.mode === 'charge' ? 'شحن' : 'تفريغ' }}</span></div>\n    </div>\n    <div v-else-if=\"id === 'chart'\" class=\"panel-body center\">{{ trials.length < 2 ? 'سجل تجربتين على الأقل' : 'رسم V vs t' }}</div>\n    <div v-else-if=\"id === 'trials'\" class=\"panel-body\">\n      <div class=\"trials-header\"><span>#</span><span>R</span><span>C</span><span>τ</span><span>V</span><span></span></div>\n      <div v-for=\"t in trials\" :key=\"t.id\" class=\"trial-row\">\n        <span>{{ t.id }}</span><span>{{ t.R }}</span><span>{{ (t.C*1000).toFixed(0) }}μF</span><span>{{ t.tau.toFixed(2) }}</span><span>{{ t.V.toFixed(2) }}</span>\n        <button class=\"del-btn\" @click=\"emit('remove', t.id)\">x</button>\n      </div>\n      <div v-if=\"!trials.length\" class=\"no-trials\">لا توجد تجارب</div>\n      <div class=\"trials-actions\"><button class=\"clear-btn\" @click=\"emit('clear')\">مسح الكل</button></div>\n    </div>\n    <div v-else-if=\"id === 'params'\" class=\"panel-body\">\n      <div class=\"param-row\"><label>R (Ω)</label><input type=\"range\" :value=\"params.R\" min=\"100\" max=\"10000\" step=\"100\" @input=\"emit('update:params', { ...params, R: +($event.target as HTMLInputElement).value })\" /><span>{{ params.R }}</span></div>\n      <div class=\"param-row\"><label>C (mF)</label><input type=\"range\" :value=\"params.C*1000\" min=\"0.1\" max=\"10\" step=\"0.1\" @input=\"emit('update:params', { ...params, C: +($event.target as HTMLInputElement).value/1000 })\" /><span>{{ (params.C*1000).toFixed(1) }}</span></div>\n      <div class=\"param-row\"><label>V₀ (V)</label><input type=\"range\" :value=\"params.V0\" min=\"1\" max=\"20\" step=\"1\" @input=\"emit('update:params', { ...params, V0: +($event.target as HTMLInputElement).value })\" /><span>{{ params.V0 }}</span></div>\n      <div class=\"param-row\"><label>الوضع</label>\n        <select :value=\"params.mode\" @change=\"emit('update:params', { ...params, mode: ($event.target as HTMLSelectElement).value as 'charge' | 'discharge' })\">\n          <option value=\"charge\">شحن</option><option value=\"discharge\">تفريغ</option>\n        </select>\n      </div>\n    </div>\n    <div v-else-if=\"id === 'laws'\" class=\"panel-body\">\n      <div class=\"law-box\"><div class=\"law-title\">ثابت الزمن</div><div class=\"formula\">τ = R × C</div></div>\n      <div class=\"law-box\"><div class=\"law-title\">الشحن</div><div class=\"formula\">V = V₀(1 - e^(-t/τ))</div></div>\n      <div class=\"law-box\"><div class=\"law-title\">التفريغ</div><div class=\"formula\">V = V₀·e^(-t/τ)
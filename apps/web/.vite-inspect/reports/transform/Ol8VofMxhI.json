      "name": "vite:load-fallback",
      "result": "<script setup lang=\"ts\">\nimport { useI18n } from '../../../composables/useI18n'\n\nconst { t } = useI18n()\ndefineProps<{ open: boolean }>()\nconst emit = defineEmits<{ (e: 'close'): void }>()\n</script>\n\n<template>\n  <Teleport to=\"body\">\n    <div v-if=\"open\" class=\"overlay\" @click.self=\"emit('close')\">\n      <div class=\"modal\">\n        <div class=\"modal-header\">\n          <h3>🚀 دليل تجربة حركة المقذوفات — دليل شامل وكامل</h3>\n          <button class=\"close-btn\" @click=\"emit('close')\">&#x2715;</button>\n        </div>\n        <div class=\"modal-body\">\n\n          <!-- 1. Theoretical Background -->\n          <section>\n            <h4>🔬 1. المقدمة والنظرية العلمية</h4>\n            <p>\n              حركة المقذوف هي حركة جسم يُطلق في الهواء بزاوية معينة تحت تأثير الجاذبية الأرضية فقط\n              (مع إهمال مقاومة الهواء). المبدأ الأساسي هنا هو <strong>استقلالية الحركة</strong>،\n              حيث تنقسم حركة المقذوف إلى بعدين (2D):\n            </p>\n            <ul>\n              <li>\n                <b>حركة أفقية (على المحور X):</b> بسرعة ثابتة (vₓ) لأنها لا تتأثر بأي قوة\n                (التسارع الأفقي aₓ = 0).\n              </li>\n              <li>\n                <b>حركة رأسية (على المحور Y):</b> بتسارع ثابت وهو تسارع الجاذبية (aᵧ = -g)،\n                حيث تبطأ السرعة أثناء الصعود وتزداد أثناء الهبوط.\n              </li>\n            </ul>\n            <p>\n              إذا انطلق المقذوف بسرعة ابتدائية v₀ وبزاوية θ مع الأفق، فإن مركبات السرعة تكون:\n            </p>\n            <div class=\"formula\">v₀ₓ = v₀ · cos(θ) &nbsp;&nbsp;&nbsp;&nbsp; v₀ᵧ = v₀ · sin(θ)</div>\n          </section>\n\n          <!-- 2. Mathematical Equations -->\n          <section>\n            <h4>📐 2. القوانين الرياضية المستعملة</h4>\n            <div class=\"method\">\n              <b>المدى الأفقي (R — Horizontal Range):</b><br>\n              R = v₀² · sin(2θ) / g\n            </div>\n            <div class=\"method\">\n              <b>أقصى ارتفاع (H — Maximum Height):</b><br>\n              H = v₀² · sin²(θ) / (2g)\n            </div>\n            <div class=\"method\">\n              <b>زمن التحليق الكلي (T — Total Time of Flight):</b><br>\n              T = 2 · v₀ · sin(θ) / g\n            </div>\n          </section>\n\n          <!-- 3. Laboratory Procedure -->\n          <section>\n            <h4>⚗️ 3. طريقة العمل في المختبر (الافتراضي)</h4>\n            <ol>\n              <li>\n                <b>تثبيت السرعة الابتدائية:</b> اختر قيمة ثابتة للسرعة الابتدائية\n                (مثلاً v₀ = 10 m/s).\n              </li>\n              <li>\n                <b>تغيير زاوية الإطلاق (θ):</b> ابدأ بزاوية 15° ثم قم بزيادتها تدريجياً\n                (30°, 45°, 60°, 75°).\n              </li>\n              <li>\n                <b>إطلاق المقذوف ورصد المدى:</b> في كل مرة، أطلق القذيفة وقس المدى الأفقي (R)\n                الذي تصل إليه بواسطة أداة القياس في المختبر.\n              </li>\n              <li>\n                <b>تسجيل البيانات:</b> رتب الزوايا والمدى المقابل لها في جدول،\n                ثم قم بحساب قيمة sin(2θ) لكل زاوية.\n              </li>\n            </ol>\n          </section>\n\n          <!-- 4. Graphical Analysis -->\n          <section>\n            <h4>📊 4. الرسم البياني، الميل، وحساب المجهول</h4>\n            <p>\n              لإيجاد قيمة السرعة الابتدائية (v₀) أو التأكد من تسارع الجاذبية (g) عبر الرسم البياني:\n            </p>\n            <ul>\n              <li>\n                <b>المحاور:</b> ارسم المدى الأفقي (R) على المحور الصادي (Y-axis).\n                ارسم جيب ضعف الزاوية (sin(2θ)) على المحور السيني (X-axis).\n              </li>\n              <li>\n                <b>الميل (Slope):</b> الرسم سيعطيك خطاً مستقيماً يمر بنقطة الأصل، وميله يُحسب كالتالي:\n                <div class=\"formula\">Slope = ΔR / Δsin(2θ)</div>\n              </li>\n              <li>\n                <b>حساب المجهول:</b> بالمقارنة مع القانون (R = v₀²/g · sin(2θ))، نجد أن:\n                <div class=\"formula\">Slope = v₀² / g</div>\n                إذا كانت g معلومة (9.8 m/s²)، يمكنك حساب السرعة الابتدائية المجهولة:\n                <div class=\"formula\">v₀ = √(Slope × g)</div>\n              </li>\n            </ul>\n          </section>\n\n          <!-- 5. Variables & Constants -->\n          <section>\n            <h4>⚙️ 5. الثوابت والمتغيرات في التجربة</h4>\n            <div class=\"element-grid\">\n              <div class=\"element\">\n                <b class=\"tag\">المتغير المستقل (الذي نتحكم به):</b> زاوية الإطلاق (θ)\n              </div>\n              <div class=\"element\">\n                <b class=\"tag\">المتغير التابع (الذي يتغير تبعاً للزاوية):</b> المدى الأفقي (R)، وأقصى ارتفاع (H)\n              </div>\n              <div class=\"element\">\n                <b class=\"tag\">الثوابت:</b> السرعة الابتدائية (v₀)، وتسارع الجاذبية الأرضية (g)\n              </div>\n            </div>\n          </section>\n\n          <!-- 6. Scientific Importance -->\n          <section>\n            <h4>🎯 6. الفائدة والأهمية العلمية للتجربة</h4>\n            <ul>\n              <li>إثبات أن أقصى مدى أفقياً يتحقق دائماً عند زاوية إطلاق مقدارها 45°.</li>\n              <li>إثبات أن الزوايا المتتمة (التي مجموعها 90° مثل 30° و 60°) تعطي نفس المدى الأفقي.</li>\n              <li>فهم وتطبيق كيفية تحليل المتجهات وفصل الحركة إلى مركبتين متعامدتين ومستقلتين.</li>\n            </ul>\n          </section>\n\n          <!-- Keyboard shortcuts -->\n          <section>\n            <h4>⌨️ اختصارات لوحة المفاتيح</h4>\n            <div class=\"kbd-grid\">\n              <span><kbd>Space</kbd> إطلاق / توقف</span>\n              <span><kbd>S</kbd> تسجيل قراءة</span>\n              <span><kbd>R</kbd> إعادة التعيين</span>\n              <span><kbd>Ctrl</kbd>+<kbd>Z</kbd> تراجع</span>\n              <span><kbd>Ctrl</kbd>+<kbd>Y</kbd> إعادة</span>\n              <span><kbd>?</kbd> فتح/إغلاق المساعدة</span>\n            </div>\n          </section>\n\n        </div>\n      </div>\n    </div>\n  </Teleport>\n</template>\n\n<style scoped>\n.overlay { position: fixed; inset: 0; z-index: 300; background: rgba(0,0,0,.6); display: flex; align-items: center; justify-content: center; padding: 1.5rem; }\n.modal { background: #131a25; border: 1px solid #2D3645; border-radius: 12px; max-width: 720px; width: 100%; max-height: 90vh; display: flex; flex-direction: column; box-shadow: 0 20px 60px rgba(0,0,0,.5); }\n.modal-header { display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.2rem; border-bottom: 1px solid #2D3645; flex-shrink: 0; }\n.modal-header h3 { margin: 0; font-size: 1rem; color: #e2e8f0; }\n.close-btn { background: transparent; border: 1px solid #2D3645; color: #8B95A5; border-radius: 6px; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 1rem; padding: 0; }\n.close-btn:hover { background: rgba(91,141,184,.1); color: #5B8DB8; }\n.modal-body { overflow-y: auto; padding: 1.2rem; font-size: .82rem; color: #cbd5e1; line-height: 1.8; direction: rtl; text-align: right; }\n.modal-body section { margin-bottom: 1.4rem; }\n.modal-body h4 { margin: 0 0 .5rem; font-size: .9rem; color: #5B8DB8; border-bottom: 1px solid #2D3645; padding-bottom: .3rem; }\n.modal-body p { margin: .4rem 0; }\n.modal-body ol, .modal-body ul { margin: .4rem 0; padding-right: 1.2rem; }\n.modal-body li { margin-bottom: .25rem; }\n.formula { background: #1a2332; border: 1px solid #2D3645; border-radius: 6px; padding: .6rem .8rem; font-family: monospace; font-size: .9rem; color: #5B8DB8; text-align: center; margin: .6rem 0; direction: ltr; }\n.element-grid { display: flex; flex-direction: column; gap: .35rem; }\n.element { background: #1a2332; border-radius: 6px; padding: .4rem .6rem; font-size: .78rem; }\n.tag { color: #5B8DB8; }\n.method { background: #1a2332; border-radius: 6px; padding: .5rem .7rem; margin-bottom: .35rem; font-size: .78rem; direction: ltr; text-align: left; }\n.kbd-grid { display: flex; flex-wrap: wrap; gap: .4rem; }\n.kbd-grid span { background: #1a2332; border: 1px solid #2D3645; border-radius: 5px; padding: .3rem .5rem; font-size: .75rem; }\nkbd { background: #252D3A; border: 1px solid #475569; border-radius: 4px; padding: .05rem .3rem; font-family: monospace; font-size: .7rem; color: #D1D7E0; }\n</style>\n",

 rgba(255, 255, 255, 0.15);\n  border-radius: 4px;\n  position: relative;\n  overflow: hidden;\n}\n\n.therm-liquid {\n  position: absolute;\n  bottom: 0;\n  left: 1px;\n  right: 1px;\n  background: #f59e0b;\n  border-radius: 0 0 2px 2px;\n  transition: height 0.3s ease, background 0.5s ease;\n}\n\n.therm-bulb {\n  width: 12px;\n  height: 12px;\n  border-radius: 50%;\n  background: #f59e0b;\n  border: 1px solid rgba(255, 255, 255, 0.2);\n  transition: background 0.5s ease;\n}\n\n.therm-bulb.hot {\n  background: #ef4444;\n  box-shadow: 0 0 6px rgba(239, 68, 68, 0.5);\n}\n\n.therm-read {\n  font-size: 0.65rem;\n  color: #8B95A5;\n  white-space: nowrap;\n}\n\n/* ===== Water Info ===== */\n.water-info {\n  display: flex;\n  gap: 0.8rem;\n  font-size: 0.65rem;\n  color: #8B95A5;\n}\n\n/* ===== Params Bar ===== */\n.params-bar {\n  display: flex;\n  justify-content: center;\n  gap: 1.5rem;\n  padding: 0.4rem;\n  background: #0d1117;\n  border-top: 1px solid #1e2530;\n  font-size: 0.7rem;\n  flex-shrink: 0;\n}\n.param-item {\n  display: flex;\n  align-items: center;\n  gap: 0.35rem;\n}\n.param-label {\n  color: #64748b;\n}\n.param-val {\n  color: #D1D7E0;\n  font-weight: 600;\n}\n\n/* ===== Transitions ===== */\n.metal-fade-enter-active, .metal-fade-leave-active { transition: all 0.5s ease; }\n.metal-fade-enter-from, .metal-fade-leave-to { opacity: 0; transform: scale(0.8); }\n\n.metal-drop-enter-active, .metal-drop-leave-active { transition: all 0.6s ease; }\n.metal-drop-enter-from { opacity: 0; transform: translateY(-20px) scale(0.8); }\n.metal-drop-leave-to { opacity: 0; transform: translateY(20px); }\n\n.metal-sink-enter-active { transition: all 0.8s ease; }\n.metal-sink-enter-from { opacity: 0; transform: translateY(-30px); }\n\n.arrow-slide-enter-active, .arrow-slide-leave-active { transition: all 0.4s ease; }\n.arrow-slide-enter-from, .arrow-slide-leave-to { opacity: 0; transform: translateX(20px); }\n\n.fade-up-enter-active, .fade-up-leave-active { transition: all 0
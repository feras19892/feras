          "<script setup lang=\"ts\">\nimport { computed, ref } from 'vue';\nimport { useSpillDrops } from '../../../composables/chemistry/useSpillDrops';\n\ninterface Props {\n  volume?: number;     // 0–300 mL\n  maxVolume?: number;  // 300\n  liquidColor?: string;\n  liquidOpacity?: number;\n  isHovered?: boolean;\n  tiltAngle?: number;\n  itemUid?: string;\n  itemX?: number;\n  itemY?: number;\n}\n\nconst props = withDefaults(defineProps<Props>(), {\n  volume: 0,\n  maxVolume: 300,\n  liquidColor: '#3b82f6',\n  liquidOpacity: 0.35,\n  isHovered: false,\n  tiltAngle: 0,\n  itemX: 0,\n  itemY: 0,\n  itemUid: '',\n});\n\nconst emit = defineEmits<{ click: []; spill: [amount: number]; dropExited: [worldX: number, worldY: number, color: string]; }>();\n\nconst canvasRef = ref<HTMLCanvasElement | null>(null);\n\nuseSpillDrops({\n  canvasRef,\n  tiltAngle: () => props.tiltAngle,\n  volume: () => props.volume,\n  maxVolume: () => props.maxVolume,\n  liquidColor: () => props.liquidColor,\n  itemX: () => props.itemX,\n  itemY: () => props.itemY,\n  mouthPosition: (tilt) => {\n    const rad = tilt * Math.PI / 180;\n    const cx = 70, cy = 119, mouthDist = 91; // cy=(neckTop28+bodyBottom210)/2\n    return { x: cx + mouthDist * Math.sin(rad), y: cy - mouthDist * Math.cos(rad) };\n  },\n  canvasW: 140,\n  canvasH: 260,\n  mouthBounds: { minX: 10, maxX: 130, minY: 10, maxY: 240 },\n  exitY: 200,\n  onSpill: (amount) => emit('spill', amount),\n  onDropExited: (wx, wy, color) => emit('dropExited', wx, wy, color),\n});\n\n/* Flask geometry */\nconst neckTop = 28;\nconst neckW = 18;\nconst neckH = 55; // neck area\nconst shoulderY = neckTop + neckH; // 83\nconst bodyBottom = 210;\nconst bodyW = 100;\nconst centerX = 70;\n\n/* Liquid fills from bottom of body up into neck */\nconst totalH = bodyBottom - shoulderY; // 127\n\nconst liquidH = computed(() => {\n  if (props.volume <= 0) return 0;\n  const pct = Math.min(props.volume / props.maxVolume, 1);\n  // Non-linear: neck fills last\n  let h: number;\n  if (pct <= 0.85) {\n    h = (pct / 0.85) * totalH; // fill body first\n  } else {\n    h = totalH + (pct - 0.85) / 0.15 * neckH;\n  }\n  return h;\n});\n\nconst liquidY = computed(() => bodyBottom - Math.min(liquidH.value, totalH));\nconst liquidNeckH = computed(() => Math.max(0, liquidH.value - totalH));\n\n/* Marks */\ninterface Mark { y: number; label: string }\nconst marks = computed<Mark[]>(() => [\n  { y: bodyBottom - totalH * 0.25, label: '75' },\n  { y: bodyBottom - totalH * 0.5, label: '150' },\n  { y: bodyBottom - totalH * 0.75, label: '225' },\n  { y: bodyBottom - totalH, label: '300' },\n]);\n</script>\n\n<template>\n  <div class=\"flask-wrapper\" @click.stop=\"emit('click')\" data-v-inspector=\"src/components/experiment/chemistry/LabErlenmeyer.vue:93:3\">\n    <svg viewBox=\"0 0 140 230\" class=\"flask-svg\" :class=\"{ hovered: isHovered }\" data-v-inspector=\"src/components/experiment/chemistry/LabErlenmeyer.vue:94:5\">\n      <!-- Shadow -->\n      <ellipse cx=\"70\" cy=\"222\" rx=\"42\" ry=\"3\" fill=\"rgba(0,0,0,0.06)\" data-v-inspector=\"src/components/experiment/chemistry/LabErlenmeyer.vue:96:7\" />\n\n      <!-- Neck (upper tube) -->\n      <path\n        d=\"M 61 28 L 61 83 L 79 83 L 79 28\"\n        fill=\"rgba(241,245,249,0.15)\"\n        stroke=\"#94a3b8\"\n        stroke-width=\"1.2\" data-v-inspector=\"src/components/experiment/chemistry/LabErlenmeyer.vue:99:7\"\n      />\n\n      <!-- Body (conical) -->\n      <path\n        d=\"M 61 83 L 20 210 Q 20 215 25 215 L 115 215 Q 120 215 120 210 L 79 83\"\n        fill=\"rgba(241,245,249,0.15)\"\n        stroke=\"#94a3b8\"\n        stroke-width=\"1.2\" data-v-inspector=\"src/components/experiment/chemistry/LabErlenmeyer.vue:107:7\"\n      />\n\n      <!-- Rim -->\n      <ellipse cx=\"70\" cy=\"28\" rx=\"11\" ry=\"3\" fill=\"none\" stroke=\"#94a3b8\" stroke-width=\"1.2\" data-v-inspector=\"src/components/experiment/chemistry/LabErlenmeyer.vue:115:7\" />\n      <ellipse cx=\"70\" cy=\"28\" rx=\"9\" ry=\"2\" fill=\"none\" stroke=\"rgba(148,163,184,0.3)\" stroke-width=\"0.5\" data-v-inspector=\"src/components/experiment/chemistry/LabErlenmeyer.vue:116:7\" />\n\n      <!-- Scale marks on neck -->\n      <line x1=\"65\" y1=\"48\" x2=\"75\" y2=\"48\" stroke=\"#64748b\" stroke-width=\"0.6\" opacity=\"0.5\" data-v-inspector=\"src/components/experiment/chemistry/LabErlenmeyer.vue:119:7\" />\n      <line x1=\"65\" y1=\"68\" x2=\"75\" y2=\"68\" stroke=\"#64748b\" stroke-width=\"0.6\" opacity=\"0.5\" data-v-inspector=\"src/components/experiment/chemistry/LabErlenmeyer.vue:120:7\" />\n\n      <!-- Scale marks on body (etched) -->\n      <g v-for=\"mark in marks\" :key=\"mark.label\" data-v-inspector=\"src/components/experiment/chemistry/LabErlenmeyer.vue:123:7\">\n        <line\n          :x1=\"centerX - 25\"\n          :y1=\"mark.y\"\n          :x2=\"centerX + 25\"\n          :y2=\"mark.y\"\n          stroke=\"#64748b\"\n          stroke-width=\"0.8\"\n          opacity=\"0.5\"\n          stroke-linecap=\"round\" data-v-inspector=\"src/components/experiment/chemistry/LabErlenmeyer.vue:124:9\"\n        />\n        <text\n          :x=\"centerX + 30\"\n          :y=\"mark.y + 2.5\"\n          font-size=\"7\"\n          fill=\"#334155\"\n          font-weight=\"700\"\n          opacity=\"0.75\" data-v-inspector=\"src/components/experiment/chemistry/LabErlenmeyer.vue:134:9\"\n        >{{ mark.label }}</text>\n      </g>\n\n      <!-- LIQUID in body -->\n      <g v-if=\"volume > 0 && liquidH > 0\" data-v-inspector=\"src/components/experiment/chemistry/LabErlenmeyer.vue:145:7\">\n        <!-- Body liquid -->\n        <path\n          v-if=\"liquidH > 0\"\n          :d=\"`M ${centerX - neckW/2 - 2} ${liquidY} L ${centerX - bodyW/2 + 2} ${bodyBottom - 4} Q ${centerX - bodyW/2 + 2} ${bodyBottom} ${centerX} ${bodyBottom} Q ${centerX + bodyW/2 - 2} ${bodyBottom} ${centerX + bodyW/2 - 2} ${bodyBottom - 4} L ${centerX + neckW/2 + 2} ${liquidY} Z`\"\n          :fill=\"liquidColor\"\n          :opacity=\"liquidOpacity\" data-v-inspector=\"src/components/experiment/chemistry/LabErlenmeyer.vue:147:9\"\n        />\n        <!-- Meniscus at body top -->\n        <ellipse\n          :cx=\"centerX\"\n          :cy=\"liquidY\"\n          :rx=\"neckW/2 + 2\"\n          ry=\"2.5\"\n          :fill=\"liquidColor\"\n          :opacity=\"liquidOpacity + 0.1\" data-v-inspector=\"src/components/experiment/chemistry/LabErlenmeyer.vue:154:9\"\n        />\n        <!-- Highlight -->\n        <ellipse\n          :cx=\"centerX\"\n          :cy=\"liquidY + 0.3\"\n          :rx=\"neckW/2 - 2\"\n          ry=\"1\"\n          fill=\"rgba(255,255,255,0.35)\" data-v-inspector=\"src/components/experiment/chemistry/LabErlenmeyer.vue:163:9\"\n        />\n        <!-- Surface level indicator (red line for transparent liquids) -->\n        <line\n          :x1=\"centerX - neckW/2 - 2\"\n          :y1=\"liquidY\"\n          :x2=\"centerX + neckW/2 + 2\"\n          :y2=\"liquidY\"\n          stroke=\"#ef4444\"\n          stroke-width=\"1.2\"\n          opacity=\"0.65\"\n          stroke-linecap=\"round\" data-v-inspector=\"src/components/experiment/chemistry/LabErlenmeyer.vue:171:9\"\n        />\n        <circle :cx=\"centerX\" :cy=\"liquidY\" r=\"2.5\" fill=\"#ef4444\" opacity=\"0.3\" data-v-inspector=\"src/components/experiment/chemistry/LabErlenmeyer.vue:181:9\" />\n        <!-- Side reflection -->\n        <path\n          :d=\"`M 25 ${liquidY + 8} L 25 ${bodyBottom - 6}`\"\n          stroke=\"rgba(255,255,255,0.18)\"\n          stroke-width=\"2\"\n          stroke-linecap=\"round\"\n          fill=\"none\" data-v-inspector=\"src/components/experiment/chemistry/LabErlenmeyer.vue:183:9\"\n        />\n      </g>\n\n      <!-- LIQUID in neck (only when >85%) -->\n      <g v-if=\"liquidNeckH > 0\" data-v-inspector=\"src/components/experiment/chemistry/LabErlenmeyer.vue:193:7\">\n        <rect\n          :x=\"centerX - neckW/2 + 1.5\"\n          :y=\"shoulderY - liquidNeckH\"\n          :width=\"neckW - 3\"\n          :height=\"liquidNeckH\"\n          :fill=\"liquidColor\"\n          :opacity=\"liquidOpacity\" data-v-inspector=\"src/components/experiment/chemistry/LabErlenmeyer.vue:194:9\"\n        />\n        <!-- Meniscus at top of neck liquid -->\n        <ellipse\n          :cx=\"centerX\"\n          :cy=\"shoulderY - liquidNeckH\"\n          :rx=\"neckW/2 - 2\"\n          ry=\"1.8\"\n          :fill=\"liquidColor\"\n          :opacity=\"liquidOpacity + 0.1\" data-v-inspector=\"src/components/experiment/chemistry/LabErlenmeyer.vue:203:9\"\n        />\n      </g>\n\n      <!-- Glass highlights -->\n      <path d=\"M 24 140 L 24 205\" stroke=\"rgba(255,255,255,0.3)\" stroke-width=\"2.5\" stroke-linecap=\"round\" fill=\"none\" data-v-inspector=\"src/components/experiment/chemistry/LabErlenmeyer.vue:214:7\" />\n      <path d=\"M 64 35 L 64 75\" stroke=\"rgba(255,255,255,0.2)\" stroke-width=\"1.5\" stroke-linecap=\"round\" fill=\"none\" data-v-inspector=\"src/components/experiment/chemistry/LabErlenmeyer.vue:215:7\" />\n      <path d=\"M 76 40 L 76 70\" stroke=\"rgba(255,255,255,0.1)\" stroke-width=\"1\" stroke-linecap=\"round\" fill=\"none\" data-v-inspector=\"src/components/experiment/chemistry/LabErlenmeyer.vue:216:7\" />\n      <path d=\"M 30 210 Q 70 215 110 210\" stroke=\"rgba(255,255,255,0.15)\" stroke-width=\"1\" fill=\"none\" data-v-inspector=\"src/components/experiment/chemistry/LabErlenmeyer.vue:217:7\" />\n    </svg>\n\n    <!-- Drop canvas -->\n    <canvas\n      v-if=\"volume > 0\"\n      ref=\"canvasRef\"\n      width=\"140\"\n      height=\"260\"\n      class=\"drop-canvas\"\n      :style=\"{ transform: `rotate(${-tiltAngle}deg)`, transformOrigin: '70px 120px' }\" data-v-inspector=\"src/components/experiment/chemistry/LabErlenmeyer.vue:221:5\"\n    />\n  </div>\n</template>\n\n<style scoped>\n.flask-wrapper {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  position: relative;\n  cursor: pointer;\n}\n.flask-svg {\n  width: 110px;\n  height: 180px;\n}\n.flask-svg.hovered {\n  transform: scale(1.05);\n}\n.drop-canvas {\n  position: absolute;\n  top: 0;\n  left: 50%;\n  width: 140px;\n  height: 260px;\n  margin-left: -70px;\n  z-index: 2;\n  pointer-events: none;\n}\n</style>\n"
        ]
      }

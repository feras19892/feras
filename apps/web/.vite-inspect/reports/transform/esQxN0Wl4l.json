        "sourcesContent": [
          "<script setup lang=\"ts\">\r\nimport { computed, ref } from 'vue';\r\n\r\ninterface Props {\r\n  volume?: number;     // 0–10 mL drawn\r\n  maxVolume?: number;  // 10\r\n  liquidColor?: string;\r\n  liquidOpacity?: number;\r\n  isHovered?: boolean;\r\n  isActive?: boolean;\r\n}\r\n\r\nconst props = withDefaults(defineProps<Props>(), {\r\n  volume: 0,\r\n  maxVolume: 10,\r\n  liquidColor: '#3b82f6',\r\n  liquidOpacity: 0.35,\r\n  isHovered: false,\r\n  isActive: false,\r\n});\r\n\r\nconst emit = defineEmits<{ click: []; }>();\r\n\r\n/* Geometry: long thin tube, small glass bulb in middle, fine tip */\r\nconst tubeBottom = 209; // where tube meets tip\r\nconst bulbTop = 142;    // where upper stem meets bulb (calibration ring)\r\nconst tubeH = tubeBottom - bulbTop; // 67px for liquid range = 10mL\r\n\r\n/* Liquid fills from bottom up to calibration ring at bulbTop */\r\nconst liquidH = computed(() => {\r\n  if (props.volume <= 0) return 0;\r\n  return (props.volume / props.maxVolume) * tubeH;\r\n});\r\nconst liquidY = computed(() => tubeBottom - liquidH.value);\r\n\r\n/* Canvas for drop effect when emptying */\r\nconst canvasRef = ref<HTMLCanvasElement | null>(null);\r\n</script>\r\n\r\n<template>\r\n  <div class=\"vpip-wrapper\" :class=\"{ active: isActive }\" @click.stop=\"emit('click')\" data-v-inspector=\"src/components/experiment/chemistry/LabVolumetricPipette.vue:41:3\">\r\n    <svg viewBox=\"0 0 40 280\" class=\"vpip-svg\" :class=\"{ hovered: isHovered }\" data-v-inspector=\"src/components/experiment/chemistry/LabVolumetricPipette.vue:42:5\">\r\n      <!-- Shadow -->\r\n      <ellipse cx=\"20\" cy=\"275\" rx=\"3\" ry=\"0.8\" fill=\"rgba(0,0,0,0.06)\" data-v-inspector=\"src/components/experiment/chemistry/LabVolumetricPipette.vue:44:7\" />\r\n\r\n      <!-- Upper stem (long thin tube) -->\r\n      <rect x=\"17\" y=\"12\" width=\"6\" height=\"130\" rx=\"1\"\r\n        fill=\"rgba(241,245,249,0.12)\"\r\n        stroke=\"#94a3b8\"\r\n        stroke-width=\"0.6\" data-v-inspector=\"src/components/experiment/chemistry/LabVolumetricPipette.vue:47:7\"\r\n      />\r\n\r\n      <!-- Small glass bulb in middle -->\r\n      <ellipse cx=\"20\" cy=\"145\" rx=\"9\" ry=\"14\"\r\n        fill=\"rgba(241,245,249,0.1)\"\r\n        stroke=\"#94a3b8\"\r\n        stroke-width=\"0.8\" data-v-inspector=\"src/components/experiment/chemistry/LabVolumetricPipette.vue:54:7\"\r\n      />\r\n\r\n      <!-- Lower stem -->\r\n      <rect x=\"17.5\" y=\"159\" width=\"5\" height=\"50\" rx=\"1\"\r\n        fill=\"rgba(241,245,249,0.12)\"\r\n        stroke=\"#94a3b8\"\r\n        stroke-width=\"0.6\" data-v-inspector=\"src/components/experiment/chemistry/LabVolumetricPipette.vue:61:7\"\r\n      />\r\n\r\n      <!-- Very fine tip (needle-like) -->\r\n      <path\r\n        d=\"M 18.5 209 L 19.5 262 L 20.5 262 L 21.5 209 Z\"\r\n        fill=\"rgba(241,245,249,0.2)\"\r\n        stroke=\"#94a3b8\"\r\n        stroke-width=\"0.5\" data-v-inspector=\"src/components/experiment/chemistry/LabVolumetricPipette.vue:68:7\"\r\n      />\r\n\r\n      <!-- Top rim -->\r\n      <ellipse cx=\"20\" cy=\"12\" rx=\"4\" ry=\"1.5\" fill=\"none\" stroke=\"#94a3b8\" stroke-width=\"0.6\" data-v-inspector=\"src/components/experiment/chemistry/LabVolumetricPipette.vue:76:7\" />\r\n\r\n      <!-- Calibration ring (red line around tube at bulb top) -->\r\n      <ellipse cx=\"20\" cy=\"142\" rx=\"10\" ry=\"2\"\r\n        fill=\"none\"\r\n        stroke=\"#dc2626\"\r\n        stroke-width=\"1.2\"\r\n        opacity=\"0.9\" data-v-inspector=\"src/components/experiment/chemistry/LabVolumetricPipette.vue:79:7\"\r\n      />\r\n      <text\r\n        x=\"32\"\r\n        y=\"144\"\r\n        font-size=\"5\"\r\n        fill=\"#dc2626\"\r\n        font-weight=\"800\"\r\n        opacity=\"0.9\" data-v-inspector=\"src/components/experiment/chemistry/LabVolumetricPipette.vue:85:7\"\r\n      >{{ maxVolume }}mL</text>\r\n\r\n      <!-- LIQUID: fills from bottom up to the red ring -->\r\n      <g v-if=\"volume > 0\" data-v-inspector=\"src/components/experiment/chemistry/LabVolumetricPipette.vue:95:7\">\r\n        <!-- Lower stem liquid -->\r\n        <rect\r\n          v-if=\"liquidY < 159\"\r\n          x=\"18.5\"\r\n          :y=\"liquidY\"\r\n          width=\"3\"\r\n          :height=\"159 - liquidY\"\r\n          rx=\"1\"\r\n          :fill=\"liquidColor\"\r\n          :opacity=\"liquidOpacity\" data-v-inspector=\"src/components/experiment/chemistry/LabVolumetricPipette.vue:97:9\"\r\n        />\r\n        <!-- Bulb liquid -->\r\n        <ellipse\r\n          v-if=\"liquidY < 159\"\r\n          cx=\"20\"\r\n          cy=\"145\"\r\n          rx=\"7\"\r\n          ry=\"12\"\r\n          :fill=\"liquidColor\"\r\n          :opacity=\"liquidOpacity\" data-v-inspector=\"src/components/experiment/chemistry/LabVolumetricPipette.vue:108:9\"\r\n        />\r\n        <!-- Upper stem liquid (if full) -->\r\n        <rect\r\n          v-if=\"liquidY < 142\"\r\n          x=\"18\"\r\n          :y=\"liquidY\"\r\n          width=\"4\"\r\n          :height=\"142 - liquidY\"\r\n          rx=\"1\"\r\n          :fill=\"liquidColor\"\r\n          :opacity=\"liquidOpacity\" data-v-inspector=\"src/components/experiment/chemistry/LabVolumetricPipette.vue:118:9\"\r\n        />\r\n        <!-- Meniscus at liquid top -->\r\n        <ellipse\r\n          :cx=\"20\"\r\n          :cy=\"liquidY\"\r\n          rx=\"2.5\"\r\n          ry=\"1\"\r\n          :fill=\"liquidColor\"\r\n          :opacity=\"liquidOpacity + 0.1\" data-v-inspector=\"src/components/experiment/chemistry/LabVolumetricPipette.vue:129:9\"\r\n        />\r\n      </g>\r\n\r\n      <!-- Glass highlight -->\r\n      <path d=\"M 18 20 L 18 135\" stroke=\"rgba(255,255,255,0.2)\" stroke-width=\"0.8\" stroke-linecap=\"round\" fill=\"none\" data-v-inspector=\"src/components/experiment/chemistry/LabVolumetricPipette.vue:140:7\" />\r\n      <path d=\"M 18 160 L 18 200\" stroke=\"rgba(255,255,255,0.15)\" stroke-width=\"0.6\" stroke-linecap=\"round\" fill=\"none\" data-v-inspector=\"src/components/experiment/chemistry/LabVolumetricPipette.vue:141:7\" />\r\n    </svg>\r\n\r\n    <!-- Drop canvas -->\r\n    <canvas\r\n      ref=\"canvasRef\"\r\n      width=\"40\"\r\n      height=\"280\"\r\n      class=\"drop-canvas\" data-v-inspector=\"src/components/experiment/chemistry/LabVolumetricPipette.vue:145:5\"\r\n    />\r\n  </div>\r\n</template>\r\n\r\n<style scoped>\r\n.vpip-wrapper {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  position: relative;\r\n  cursor: pointer;\r\n}\r\n.vpip-wrapper.active {\r\n  filter: drop-shadow(0 0 12px rgba(59,130,246,0.4));\r\n}\r\n.vpip-svg {\r\n  width: 36px;\r\n  height: 230px;\r\n  transition: transform 0.2s, filter 0.2s;\r\n  filter: drop-shadow(0 2px 5px rgba(0,0,0,0.06));\r\n}\r\n.vpip-svg.hovered {\r\n  transform: scale(1.08);\r\n  filter: drop-shadow(0 4px 10px rgba(0,0,0,0.1));\r\n}\r\n.drop-canvas {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 50%;\r\n  width: 40px;\r\n  height: 280px;\r\n  margin-left: -20px;\r\n  z-index: 2;\r\n  pointer-events: none;\r\n}\r\n</style>\r\n"

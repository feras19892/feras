          "<script setup lang=\"ts\">\nimport { computed, ref } from 'vue';\nimport { useSpillDrops } from '../../../composables/chemistry/useSpillDrops';\n\ninterface Props {\n  volume?: number;     // 0–250 mL\n  maxVolume?: number;  // 250\n  liquidColor?: string;\n  liquidOpacity?: number;\n  isHovered?: boolean;\n  tiltAngle?: number;\n  itemUid?: string;\n  itemX?: number;\n  itemY?: number;\n}\n\nconst props = withDefaults(defineProps<Props>(), {\n  volume: 0,\n  maxVolume: 250,\n  liquidColor: '#3b82f6',\n  liquidOpacity: 0.35,\n  isHovered: false,\n  tiltAngle: 0,\n  itemX: 0,\n  itemY: 0,\n  itemUid: '',\n});\n\nconst emit = defineEmits<{ click: []; spill: [amount: number]; dropExited: [worldX: number, worldY: number, color: string]; }>();\n\nconst canvasRef = ref<HTMLCanvasElement | null>(null);\n\nuseSpillDrops({\n  canvasRef,\n  tiltAngle: () => props.tiltAngle,\n  volume: () => props.volume,\n  maxVolume: () => props.maxVolume,\n  liquidColor: () => props.liquidColor,\n  itemX: () => props.itemX,\n  itemY: () => props.itemY,\n  mouthPosition: (tilt) => {\n    const rad = tilt * Math.PI / 180;\n    const cx = 60, cy = 114, mouthDist = 96; // cy=(neckTop18+bulbBottom210)/2\n    return { x: cx + mouthDist * Math.sin(rad), y: cy - mouthDist * Math.cos(rad) };\n  },\n  canvasW: 120,\n  canvasH: 260,\n  mouthBounds: { minX: 10, maxX: 110, minY: 10, maxY: 240 },\n  exitY: 200,\n  onSpill: (amount) => emit('spill', amount),\n  onDropExited: (wx, wy, color) => emit('dropExited', wx, wy, color),\n});\n\n/* Geometry: perfectly round bottom */\nconst bulbTop = 70;\nconst bulbBottom = 210;\nconst bulbH = bulbBottom - bulbTop;\nconst neckTop = 18;\nconst neckW = 16;\nconst centerX = 60;\nconst bulbW = 60;\n\n/* Liquid */\nconst liquidH = computed(() => {\n  if (props.volume <= 0) return 0;\n  return (props.volume / props.maxVolume) * bulbH;\n});\nconst liquidY = computed(() => bulbBottom - liquidH.value);\n\n/* Scale marks */\ninterface Mark { y: number; label: string }\nconst marks = computed<Mark[]>(() => [\n  { y: bulbBottom - bulbH * 0.25, label: '62' },\n  { y: bulbBottom - bulbH * 0.5, label: '125' },\n  { y: bulbBottom - bulbH * 0.75, label: '188' },\n  { y: bulbBottom - bulbH, label: '250' },\n]);\n</script>\n\n<template>\n  <div class=\"rbf-wrapper\" @click.stop=\"emit('click')\" data-v-inspector=\"src/components/experiment/chemistry/LabRoundBottomFlask.vue:81:3\">\n    <svg viewBox=\"0 0 120 220\" class=\"rbf-svg\" :class=\"{ hovered: isHovered }\" data-v-inspector=\"src/components/experiment/chemistry/LabRoundBottomFlask.vue:82:5\">\n      <!-- Shadow -->\n      <ellipse cx=\"60\" cy=\"215\" rx=\"32\" ry=\"3\" fill=\"rgba(0,0,0,0.06)\" data-v-inspector=\"src/components/experiment/chemistry/LabRoundBottomFlask.vue:84:7\" />\n\n      <!-- Round bottom bulb -->\n      <path\n        d=\"M 32 70 Q 30 105 22 130 Q 18 155 30 180 Q 42 210 60 210 Q 78 210 90 180 Q 102 155 98 130 Q 90 105 88 70\"\n        fill=\"rgba(241,245,249,0.15)\"\n        stroke=\"#94a3b8\"\n        stroke-width=\"1.2\" data-v-inspector=\"src/components/experiment/chemistry/LabRoundBottomFlask.vue:87:7\"\n      />\n\n      <!-- Neck -->\n      <rect\n        :x=\"centerX - neckW/2\"\n        :y=\"neckTop\"\n        :width=\"neckW\"\n        :height=\"bulbTop - neckTop\"\n        rx=\"1\"\n        fill=\"rgba(241,245,249,0.15)\"\n        stroke=\"#94a3b8\"\n        stroke-width=\"1.2\" data-v-inspector=\"src/components/experiment/chemistry/LabRoundBottomFlask.vue:95:7\"\n      />\n\n      <!-- Standard taper joint (ground glass) -->\n      <rect\n        :x=\"centerX - neckW/2 - 2\"\n        :y=\"neckTop + 2\"\n        :width=\"neckW + 4\"\n        :height=\"8\"\n        rx=\"1\"\n        fill=\"none\"\n        stroke=\"#64748b\"\n        stroke-width=\"0.8\" data-v-inspector=\"src/components/experiment/chemistry/LabRoundBottomFlask.vue:107:7\"\n      />\n\n      <!-- Rim -->\n      <ellipse :cx=\"centerX\" :cy=\"neckTop\" :rx=\"neckW/2 + 3\" ry=\"3\" fill=\"none\" stroke=\"#94a3b8\" stroke-width=\"1.2\" data-v-inspector=\"src/components/experiment/chemistry/LabRoundBottomFlask.vue:119:7\" />\n\n      <!-- Scale marks (etched on body) -->\n      <g v-for=\"mark in marks\" :key=\"mark.label\" data-v-inspector=\"src/components/experiment/chemistry/LabRoundBottomFlask.vue:122:7\">\n        <line\n          :x1=\"centerX - bulbW/2 + 4\"\n          :y1=\"mark.y\"\n          :x2=\"centerX + bulbW/2 - 4\"\n          :y2=\"mark.y\"\n          stroke=\"#64748b\"\n          stroke-width=\"0.8\"\n          opacity=\"0.5\"\n          stroke-linecap=\"round\" data-v-inspector=\"src/components/experiment/chemistry/LabRoundBottomFlask.vue:123:9\"\n        />\n        <text\n          :x=\"centerX + bulbW/2 + 2\"\n          :y=\"mark.y + 2.5\"\n          font-size=\"6\"\n          fill=\"#334155\"\n          font-weight=\"700\"\n          opacity=\"0.75\" data-v-inspector=\"src/components/experiment/chemistry/LabRoundBottomFlask.vue:133:9\"\n        >{{ mark.label }}</text>\n      </g>\n\n      <!-- LIQUID -->\n      <g v-if=\"volume > 0\" data-v-inspector=\"src/components/experiment/chemistry/LabRoundBottomFlask.vue:144:7\">\n        <path\n          :d=\"`M ${32 + (2 * (bulbBottom - liquidY)/bulbH)} ${liquidY} Q ${22 + (4 * (bulbBottom - liquidY)/bulbH)} ${(liquidY + bulbBottom)/2} ${30 + (6 * (bulbBottom - liquidY)/bulbH)} ${bulbBottom - 5} Q ${42} ${bulbBottom - 2} ${60} ${bulbBottom - 2} Q ${78} ${bulbBottom - 2} ${90 - (6 * (bulbBottom - liquidY)/bulbH)} ${bulbBottom - 5} Q ${98 - (4 * (bulbBottom - liquidY)/bulbH)} ${(liquidY + bulbBottom)/2} ${88 - (2 * (bulbBottom - liquidY)/bulbH)} ${liquidY} Z`\"\n          :fill=\"liquidColor\"\n          :opacity=\"liquidOpacity\" data-v-inspector=\"src/components/experiment/chemistry/LabRoundBottomFlask.vue:145:9\"\n        />\n        <!-- Meniscus -->\n        <ellipse\n          :cx=\"centerX\"\n          :cy=\"liquidY\"\n          :rx=\"bulbW/2 - 4\"\n          ry=\"2.5\"\n          :fill=\"liquidColor\"\n          :opacity=\"liquidOpacity + 0.1\" data-v-inspector=\"src/components/experiment/chemistry/LabRoundBottomFlask.vue:151:9\"\n        />\n        <!-- Highlight -->\n        <ellipse\n          :cx=\"centerX\"\n          :cy=\"liquidY + 0.3\"\n          :rx=\"bulbW/2 - 10\"\n          ry=\"1\"\n          fill=\"rgba(255,255,255,0.4)\" data-v-inspector=\"src/components/experiment/chemistry/LabRoundBottomFlask.vue:160:9\"\n        />\n        <!-- Surface level indicator (visible even for transparent liquids) -->\n        <line\n          :x1=\"centerX - bulbW/2 + 8\"\n          :y1=\"liquidY\"\n          :x2=\"centerX + bulbW/2 - 8\"\n          :y2=\"liquidY\"\n          stroke=\"#ef4444\"\n          stroke-width=\"1.2\"\n          opacity=\"0.7\"\n          stroke-linecap=\"round\" data-v-inspector=\"src/components/experiment/chemistry/LabRoundBottomFlask.vue:168:9\"\n        />\n        <circle :cx=\"centerX\" :cy=\"liquidY\" r=\"2.5\" fill=\"#ef4444\" opacity=\"0.35\" data-v-inspector=\"src/components/experiment/chemistry/LabRoundBottomFlask.vue:178:9\" />\n      </g>\n\n      <!-- Glass highlights -->\n      <line :x1=\"centerX - bulbW/2 + 8\" :y1=\"bulbTop + 10\" :x2=\"centerX - bulbW/2 + 14\" :y2=\"bulbBottom - 20\" stroke=\"rgba(255,255,255,0.3)\" stroke-width=\"2\" stroke-linecap=\"round\" data-v-inspector=\"src/components/experiment/chemistry/LabRoundBottomFlask.vue:182:7\" />\n      <line :x1=\"centerX - neckW/2 + 3\" :y1=\"neckTop + 5\" :x2=\"centerX - neckW/2 + 3\" :y2=\"bulbTop - 5\" stroke=\"rgba(255,255,255,0.35)\" stroke-width=\"1.5\" stroke-linecap=\"round\" data-v-inspector=\"src/components/experiment/chemistry/LabRoundBottomFlask.vue:183:7\" />\n    </svg>\n\n    <canvas\n      v-if=\"volume > 0\"\n      ref=\"canvasRef\"\n      width=\"120\"\n      height=\"260\"\n      class=\"drop-canvas\"\n      :style=\"{ transform: `rotate(${-tiltAngle}deg)`, transformOrigin: '60px 115px' }\" data-v-inspector=\"src/components/experiment/chemistry/LabRoundBottomFlask.vue:186:5\"\n    />\n  </div>\n</template>\n\n<style scoped>\n.rbf-wrapper {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  position: relative;\n  cursor: pointer;\n}\n.rbf-svg {\n  width: 72px;\n  height: 132px;\n}\n.rbf-svg.hovered {\n  transform: scale(1.05);\n}\n.drop-canvas {\n  position: absolute;\n  top: 0;\n  left: 50%;\n  width: 120px;\n  height: 260px;\n  margin-left: -60px;\n  z-index: 2;\n  pointer-events: none;\n}\n</style>\n"
        ]
      }

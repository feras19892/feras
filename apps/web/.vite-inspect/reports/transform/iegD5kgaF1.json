      "name": "vite:load-fallback",
      "result": "<script setup lang=\"ts\">\nimport { useI18n } from '../../../composables/useI18n'\nconst { t } = useI18n()\ndefineProps<{ open: boolean }>()\nconst emit = defineEmits<{ (e: 'close'): void }>()\n</script>\n\n<template>\n  <Teleport to=\"body\">\n    <div v-if=\"open\" class=\"overlay\" @click.self=\"emit('close')\">\n      <div class=\"modal\">\n        <div class=\"modal-header\">\n          <h3>〰️ دليل تجربة تداخل الضوء — شقّي يونغ (Double Slit Interference) — دليل شامل وكامل</h3>\n          <button class=\"close-btn\" @click=\"emit('close')\">&#x2715;</button>\n        </div>\n        <div class=\"modal-body\">\n\n          <!-- 1. Apparatus Description -->\n          <section>\n            <h4>🔧 1. وصف تفصيلي لأدوات التجربة بالمختبر</h4>\n            <ul>\n              <li>\n                <b>المقعد أو القضيب البصري (Optical Bench):</b>\n                المسار المعدني المدرج الذي يحمل جميع المكونات على خط استقامة واحد لمنع أي انحراف في الحزمة الضوئية.\n              </li>\n              <li>\n                <b>مصدر ضوء ليزري أحادي اللون (Monochromatic Laser Source):</b>\n                ليزر (مثل الليزر الأحمر بطول موجي معلوم λ = 632.8 nm)، ويُستخدم لضمان الحصول على موجات ضوئية متشاكهة (Coherent)\n                لها نفس التردد، والسعة، وفرق طور ثابت، وهو شرط أساسي لحدوث تداخل مستقر.\n              </li>\n              <li>\n                <b>شريحة الشق المزدوج (Double Slit Plate):</b>\n                شريحة تحتوي على فتحتين مستطيلتين متوازيتين ودقيقتين جداً، المسافة الفاصلة بين مركزي الشقين معلومة ومحددة بدقة\n                وتُقاس بالملليمتر أو الميكرومتر، ويرمز لها بالرمز (d).\n              </li>\n              <li>\n                <b>شاشة الاستقبال البيضاء (Observation Screen):</b>\n                شاشة مسطحة توضع على مسافة بعيدة من الشقوق لاستقبال النمط المتكون (أهداب التداخل) وقياسها.\n              </li>\n              <li>\n                <b>الورنية الرقمية أو أداة القياس المجهري (Digital Caliper):</b>\n                أداة لقياس المسافات الصغيرة جداً بالملليمتر بين الأهداب المضيئة المتتالية المتشكلة على الشاشة.\n              </li>\n            </ul>\n          </section>\n\n          <!-- 2. Theoretical Background -->\n          <section>\n            <h4>🔬 2. المقدمة والنظرية العلمية بالتفصيل</h4>\n            <p>\n              عندما يسقط شعاع الليزر المتشاكه على الشقين، يعمل كل شق كمصدر ضوئي ثانٍ يرسل موجات أسطوانية جديدة (بناءً على <b>مبدأ هويغنز</b>).\n              تنطلق الموجتان من الشقين في نفس الوقت وبنفس الطور، وتنتشران في الفراغ حتى تتراكبا (تتداخلا) قبل وصولهما إلى الشاشة.\n            </p>\n            <p>\n              ينتج عن تراكب الموجات نوعان من التداخل بناءً على فرق المسار بينهما:\n            </p>\n            <ul>\n              <li><b>التدالب البنّاء (Constructive Interference):</b> يحدث عندما تلتقي قمة موجة مع قمة موجة أخرى، فيقويان بعضهما البعض، ويظهر ذلك على الشاشة على شكل أهداب مضيئة (Bright Fringes).</li>\n              <li><b>التداخل الهدّام (Destructive Interference):</b> يحدث عندما تلتقي قمة موجة مع قاع موجة أخرى، فتلغي كل منهما الأخرى، ويظهر ذلك على شكل أهداب مظلمة (Dark Fringes).</li>\n            </ul>\n            <p>\n              تظهر النتيجة على الشاشة كنمط منتظم متبادل من الخطوط المضيئة والمظلمة، وأهداب التداخل هنا متساوية في العرض تقريباً\n              ويفصل بينها مسافات منتظمة ومتساوية تُسمى المسافة بين هدبين متتاليين (Δy).\n            </p>\n          </section>\n\n          <!-- 3. Mathematical Equations -->\n          <section>\n            <h4>📐 3. القوانين الرياضية المستعملة</h4>\n            <p><b>شرط الأهداب المضيئة:</b></p>\n            <div class=\"formula\">d · sin(θ) = m · λ</div>\n            <p>(حيث d المسافة بين الشقين، θ زاوية التداخل، m رتبة الهدب المضيء 0, ±1, ±2 …).</p>\n            <p><b>قانون المسافة بين هدبين مضيئين متتاليين (Δy):</b></p>\n            <div class=\"formula\">Δy = λ · D / d</div>\n            <p><b>المعادلة الخطية المستخدمة في الرسم:</b></p>\n            <div class=\"formula\">Δy = (λD) · (1/d)</div>\n          </section>\n\n          <!-- 4. Laboratory Procedure -->\n          <section>\n            <h4>⚗️ 4. طريقة العمل في المختبر بالتفصيل الممل</h4>\n            <ol>\n              <li>\n                <b>إعداد الهندسة البصرية:</b> ثبّت جهاز الليزر، يليه حامل شريحة الشق المزدوج، ثم ضع الشاشة البيضاء في النهاية.\n                قس المسافة الفاصلة بين الشريحة والشاشة بدقة بالمسطرة واجعلها ثابتة تماماً (مثلاً D = 2.0 meters).\n              </li>\n              <li>\n                <b>البدء بالشق الأول:</b> اختر شقاً مزدوجاً بمسافة فاصلة معلومة وصغيرة جداً بين الفتحتين (مثلاً d = 0.12 mm).\n              </li>\n              <li>\n                <b>تشغيل ورصد النمط:</b> شغّل الليزر ليمر عبر الشق المزدوج. ستشاهد نمط تداخل رائع يتكون من خطوط مضيئة ومظلمة متتالية ومتقاربة جداً.\n              </li>\n              <li>\n                <b>قياس المسافة بين الأهداب:</b> لضمان أعلى دقة، استخدم الورنية الرقمية لقياس المسافة الكلية بين 5 أهداب مضيئة متتالية\n                (مثلاً من الهدب m=-2 إلى m=+2)، ثم اقسم القراءة الكلية على 4 للحصول على المسافة الدقيقة بين هدبين متتاليين فقط وسجّلها كـ (Δy).\n              </li>\n              <li>\n                <b>تغيير المسافة بين الشقين:</b> انتقل إلى شقوق مزدوجة أخرى ذات مسافات فاصلة أكبر (d = 0.18 mm, 0.25 mm, 0.35 mm, …)،\n                وفي كل مرة قس قيمة (Δy) المقابلة. ستلاحظ تجريبياً أنه كلما زادت المسافة بين الشقين (d)، تقاربت الأهداب وصغرت (Δy).\n              </li>\n              <li>\n                <b>الحسابات:</b> رتّب القيم في جدول، واحسب مقلوب المسافة بين الشقين (1/d) لكل المحاولات لتجهيز القراءات للتمثيل البياني الخطي.\n              </li>\n            </ol>\n          </section>\n\n          <!-- 5. Graphical Analysis -->\n          <section>\n            <h4>📊 5. الرسم البياني، الميل، وحساب المجهول</h4>\n            <p>الهدف هو إيجاد الطول الموجي للشعاع الضوئي (λ) بيانيّاً للتأكد من دقة التجربة.</p>\n            <ul>\n              <li>\n                <b>المحاور:</b> ارسم المسافة بين الهدبين المتتاليين (Δy) بالملليمتر على المحور الصادي (Y-axis).\n                ارسم مقلوب المسافة بين الشقين (1/d) بمقلوب الملليمتر على المحور السيني (X-axis).\n              </li>\n              <li>\n                <b>الميل (Slope):</b> ستحصل على خط مستقيم يمر بنقطة الأصل يوضح التناسب الطردي بين Δy و (1/d)، احسب ميله:\n                <div class=\"formula\">Slope = Δ(Δy) / Δ(1/d)</div>\n              </li>\n              <li>\n                <b>حساب المجهول (λ):</b> بالمقارنة الفيزيائية مع المعادلة النظرية (Δy = λD · 1/d)، نجد أن الميل يساوي:\n                <div class=\"formula\">Slope = λ · D</div>\n                وبما أن مسافة الشاشة (D) معلومة وثابتة، نستخرج الطول الموجي المجهول:\n                <div class=\"formula\">λ = Slope / D</div>\n              </li>\n            </ul>\n          </section>\n\n          <!-- 6. Variables & Constants -->\n          <section>\n            <h4>⚙️ 6. الثوابت والمتغيرات في التجربة</h4>\n            <div class=\"element-grid\">\n              <div class=\"element\">\n                <b class=\"tag\">المتغير المستقل:</b> المسافة الفاصلة بين الشقين المزدوجين (d) وبالتالي مقلوبها (1/d)\n              </div>\n              <div class=\"element\">\n                <b class=\"tag\">المتغير التابع:</b> المسافة بين أهداب التداخل المضيئة المتتالية على الشاشة (Δy)\n              </div>\n              <div class=\"element\">\n                <b class=\"tag\">الثوابت:</b> المسافة بين الشقوق والشاشة (D)، والطول الموجي لليزر المستعمل (λ)\n              </div>\n            </div>\n          </section>\n\n          <!-- 7. Scientific Importance -->\n          <section>\n            <h4>🎯 7. الفائدة والأهمية العلمية للتجربة</h4>\n            <ul>\n              <li>إثبات الطبيعة الموجية للضوء وسلوكه التداخلي بشكل لا يقبل الشك.</li>\n              <li>قياس الأطوال الموجية الدقيقة لمصادر الضوء المختلفة بدقة متناهية.</li>\n              <li>تُعتبر هذه التجربة هي الأساس البصري الذي انطلقت منه لاحقاً فيزياء الكم (Quantum Mechanics) عندما أُعيدت التجربة باستخدام الإلكترونات والجزيئات المنفردة لإثبات الثنائية الموجية-الجسيمية للمادة (Wave-Particle Duality).</li>\n            </ul>\n          </section>\n\n          <!-- Keyboard shortcuts -->\n          <section>\n            <h4>⌨️ اختصارات لوحة المفاتيح</h4>\n            <div class=\"kbd-grid\">\n              <span><kbd>Space</kbd> بدء / توقف</span>\n              <span><kbd>S</kbd> تسجيل قراءة</span>\n              <span><kbd>R</kbd> إعادة التعيين</span>\n              <span><kbd>Ctrl</kbd>+<kbd>Z</kbd> تراجع</span>\n              <span><kbd>Ctrl</kbd>+<kbd>Y</kbd> إعادة</span>\n              <span><kbd>?</kbd> فتح/إغلاق المساعدة</span>\n            </div>\n          </section>\n\n        </div>\n      </div>\n    </div>\n  </Teleport>\n</template>\n\n<style scoped>\n.overlay { position: fixed; inset: 0; z-index: 300; background: rgba(0,0,0,.6); display: flex; align-items: center; justify-content: center; padding: 1.5rem; }\n.modal { background: #131a25; border: 1px solid #2D3645; border-radius: 12px; max-width: 720px; width: 100%; max-height: 90vh; display: flex; flex-direction: column; box-shadow: 0 20px 60px rgba(0,0,0,.5); }\n.modal-header { display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.2rem; border-bottom: 1px solid #2D3645; flex-shrink: 0; }\n.modal-header h3 { margin: 0; font-size: 1rem; color: #e2e8f0; }\n.close-btn { background: transparent; border: 1px solid #2D3645; color: #8B95A5; border-radius: 6px; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 1rem; padding: 0; }\n.close-btn:hover { background: rgba(91,141,184,.1); color: #5B8DB8; }\n.modal-body { overflow-y: auto; padding: 1.2rem; font-size: .82rem; color: #cbd5e1; line-height: 1.8; direction: rtl; text-align: right; }\n.modal-body section { margin-bottom: 1.4rem; }\n.modal-body h4 { margin: 0 0 .5rem; font-size: .9rem; color: #5B8DB8; border-bottom: 1px solid #2D3645; padding-bottom: .3rem; }\n.modal-body p { margin: .4rem 0; }\n.modal-body ol, .modal-body ul { margin: .4rem 0; padding-right: 1.2rem; }\n.modal-body li { margin-bottom: .25rem; }\n.formula { background: #1a2332; border: 1px solid #2D3645; border-radius: 6px; padding: .6rem .8rem; font-family: monospace; font-size: .9rem; color: #5B8DB8; text-align: center; margin: .6rem 0; direction: ltr; }\n.element-grid { display: flex; flex-direction: column; gap: .35rem; }\n.element { background: #1a2332; border-radius: 6px; padding: .4rem .6rem; font-size: .78rem; }\n.tag { color: #5B8DB8; }\n.kbd-grid { display: flex; flex-wrap: wrap; gap: .4rem; }\n.kbd-grid span { background: #1a2332; border: 1px solid #2D3645; border-radius: 5px; padding: .3rem .5rem; font-size: .75rem; }\nkbd { background: #252D3A; border: 1px solid #475569; border-radius: 4px; padding: .05rem .3rem; font-family: monospace; font-size: .7rem; color: #D1D7E0; }\n</style>\n",

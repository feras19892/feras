      "name": "vite:load-fallback",
      "result": "<script setup lang=\"ts\">\nimport { useI18n } from '../../../composables/useI18n'\n\nconst { t } = useI18n()\ndefineProps<{ open: boolean }>()\nconst emit = defineEmits<{ (e: 'close'): void }>()\n</script>\n\n<template>\n  <Teleport to=\"body\">\n    <div v-if=\"open\" class=\"overlay\" @click.self=\"emit('close')\">\n      <div class=\"modal\">\n        <div class=\"modal-header\">\n          <h3>⚖️ دليل تجربة محصلة توازن قوى — دليل شامل وكامل</h3>\n          <button class=\"close-btn\" @click=\"emit('close')\">&#x2715;</button>\n        </div>\n        <div class=\"modal-body\">\n\n          <!-- 1. Theoretical Background -->\n          <section>\n            <h4>🔬 1. المقدمة والنظرية العلمية</h4>\n            <p>\n              القوة هي <strong>كمية متجهة (Vector)</strong> لها مقدار واتجاه. عندما تؤثر عدة قوى على جسم ما في نفس الوقت،\n              فإن التأثير الإجمالي لها يُسمى <strong>القوة المحصلة (Resultant Force)</strong>.\n            </p>\n            <p>\n              لكي يكون الجسم في حالة <strong>اتزان سكوني (Static Equilibrium)</strong>، يجب أن يتحقق شرط الاتزان الأول،\n              وهو أن تكون المحصلة المتجهة لجميع القوى المؤثرة على الجسم تساوي صفراً:\n            </p>\n            <div class=\"formula\">Σ F⃗ = 0</div>\n            <p>\n              في هذه التجربة، إذا أثرت قوتان (F⃗₁ و F⃗₂) على حلقة مركزية، فإن محصلتهما (F_R) تحتاج إلى قوة ثالثة\n              مساوية لها في المقدار ومعاكسة لها في الاتجاه تسمى <strong>القوة الموازِنة (Equilibrant Force - F⃗_E)</strong>:\n            </p>\n            <div class=\"formula\">F⃗_E = -F⃗_R</div>\n          </section>\n\n          <!-- 2. Mathematical Equations -->\n          <section>\n            <h4>📐 2. القوانين الرياضية المستعملة (التحليل المركب)</h4>\n            <p>لإيجاد المحصلة تحليلياً، نقوم بتحليل كل قوة إلى مركبتين (أفقية ورأسية):</p>\n            <div class=\"method\"><b>المركبات الأفقية (X):</b> ΣFₓ = F₁·cos(θ₁) + F₂·cos(θ₂)</div>\n            <div class=\"method\"><b>المركبات الرأسية (Y):</b> ΣFᵧ = F₁·sin(θ₁) + F₂·sin(θ₂)</div>\n            <div class=\"method\">\n              <b>مقدار القوة المحصلة (F_R):</b><br>\n              F_R = √(ΣFₓ² + ΣFᵧ²)\n            </div>\n            <div class=\"method\">\n              <b>اتجاه القوة المحصلة (φ):</b><br>\n              φ = tan⁻¹(ΣFᵧ / ΣFₓ)\n            </div>\n            <div class=\"method\">\n              <b>زاوية القوة الموازِنة:</b><br>\n              θ_E = φ + 180°\n            </div>\n          </section>\n\n          <!-- 3. Laboratory Procedure -->\n          <section>\n            <h4>⚗️ 3. طريقة العمل في المختبر (الافتراضي)</h4>\n            <ol>\n              <li>\n                <b>تحديد القوتين:</b> اختر قيمتين للقوى (بواسطة كتل معلقة، حيث F = m·g) وزاويتين مختلفتين\n                (مثلاً: F₁ = 2 N عند زاوية 0°، و F₂ = 3 N عند زاوية 120°).\n              </li>\n              <li>\n                <b>رصد عدم الاتزان:</b> ستلاحظ أن الحلقة المركزية تتحرك مبتعدة عن المركز بسبب وجود قوة محصلة.\n              </li>\n              <li>\n                <b>الموازنة التجريبية:</b> ابدأ بإضافة كتل (قوة ثالثة F_E) وتغيير زاويتها تدريجياً حتى تعود الحلقة المركزية\n                إلى المنتصف تماماً وتصبح حرة ولا تلمس المحور المركزي.\n              </li>\n              <li>\n                <b>تسجيل النتائج:</b> سجّل مقدار القوة الثالثة والزاوية التي حققت التوازن الكامل.\n              </li>\n            </ol>\n          </section>\n\n          <!-- 4. Graphical Analysis -->\n          <section>\n            <h4>📊 4. التحليل البياني وحساب المجهول</h4>\n            <p>في هذه التجربة، نستخدم <strong>طريقة رسم المتجهات (Vector Polygon / Parallelogram Method)</strong> للتأكد من المجهول:</p>\n            <ul>\n              <li>\n                <b>طريقة متوازي الأضلاع:</b>\n                <ol>\n                  <li>اختر مقياس رسم مناسب (مثلاً: 1 N = 2 cm).</li>\n                  <li>ارسم المتجه F⃗₁ بزاويته، ومن نفس نقطة الأصل ارسم المتجه F⃗₂ بزاويته.</li>\n                  <li>أكمل رسم متوازي الأضلاع. القطر الواصل من نقطة الأصل يمثل القوة المحصلة بيانيّاً (F⃗_R).</li>\n                </ol>\n              </li>\n              <li>\n                <b>حساب المجهول:</b> قس طول القطر بالمسطرة وحوّله إلى نيوتن، وقس زاويته بالمنقلة.\n                قارن القيمة البيانية والنظرية مع القوة الموازِنة (F_E) التي أوجدتها عملياً للتأكد من أن:\n                <div class=\"formula\">F_E = F_R &nbsp;&nbsp;و&nbsp;&nbsp; θ_E = φ ± 180°</div>\n              </li>\n            </ul>\n          </section>\n\n          <!-- 5. Variables & Constants -->\n          <section>\n            <h4>⚙️ 5. الثوابت والمتغيرات في التجربة</h4>\n            <div class=\"element-grid\">\n              <div class=\"element\">\n                <b class=\"tag\">المتغيرات المستقلة:</b> مقادير وزوايا القوى الأولى والثانية (F₁, θ₁, F₂, θ₂)\n              </div>\n              <div class=\"element\">\n                <b class=\"tag\">المتغيرات التابعة:</b> القوة الموازِنة وزاويتها (F_E, θ_E) اللازمة لتحقيق الاتزان\n              </div>\n              <div class=\"element\">\n                <b class=\"tag\">الثوابت:</b> عجلة الجاذبية (g) ونقطة الاتزان المركزية\n              </div>\n            </div>\n          </section>\n\n          <!-- 6. Scientific Importance -->\n          <section>\n            <h4>🎯 6. الفائدة والأهمية العلمية للتجربة</h4>\n            <ul>\n              <li>الفهم التطبيقي لجمع المتجهات هندسياً وتحليلياً بدلاً من الجمع الجبري البسيط.</li>\n              <li>فهم مبادئ السكون (Statics) والاتزان، وهو المبدأ الأساسي المعتمد في الهندسة المدنية والمعمارية لتصميم الجسور والمباني لضمان عدم انهيارها تحت تأثير القوى.</li>\n            </ul>\n          </section>\n\n          <!-- Keyboard shortcuts -->\n          <section>\n            <h4>⌨️ اختصارات لوحة المفاتيح</h4>\n            <div class=\"kbd-grid\">\n              <span><kbd>R</kbd> إعادة التعيين</span>\n              <span><kbd>S</kbd> تسجيل قراءة</span>\n              <span><kbd>Ctrl</kbd>+<kbd>Z</kbd> تراجع</span>\n              <span><kbd>Ctrl</kbd>+<kbd>Y</kbd> إعادة</span>\n              <span><kbd>?</kbd> فتح/إغلاق المساعدة</span>\n            </div>\n          </section>\n\n        </div>\n      </div>\n    </div>\n  </Teleport>\n</template>\n\n<style scoped>\n.overlay { position: fixed; inset: 0; z-index: 300; background: rgba(0,0,0,.6); display: flex; align-items: center; justify-content: center; padding: 1.5rem; }\n.modal { background: #131a25; border: 1px solid #2D3645; border-radius: 12px; max-width: 720px; width: 100%; max-height: 90vh; display: flex; flex-direction: column; box-shadow: 0 20px 60px rgba(0,0,0,.5); }\n.modal-header { display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.2rem; border-bottom: 1px solid #2D3645; flex-shrink: 0; }\n.modal-header h3 { margin: 0; font-size: 1rem; color: #e2e8f0; }\n.close-btn { background: transparent; border: 1px solid #2D3645; color: #8B95A5; border-radius: 6px; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 1rem; padding: 0; }\n.close-btn:hover { background: rgba(91,141,184,.1); color: #5B8DB8; }\n.modal-body { overflow-y: auto; padding: 1.2rem; font-size: .82rem; color: #cbd5e1; line-height: 1.8; direction: rtl; text-align: right; }\n.modal-body section { margin-bottom: 1.4rem; }\n.modal-body h4 { margin: 0 0 .5rem; font-size: .9rem; color: #5B8DB8; border-bottom: 1px solid #2D3645; padding-bottom: .3rem; }\n.modal-body p { margin: .4rem 0; }\n.modal-body ol, .modal-body ul { margin: .4rem 0; padding-right: 1.2rem; }\n.modal-body li { margin-bottom: .25rem; }\n.formula { background: #1a2332; border: 1px solid #2D3645; border-radius: 6px; padding: .6rem .8rem; font-family: monospace; font-size: .9rem; color: #5B8DB8; text-align: center; margin: .6rem 0; direction: ltr; }\n.element-grid { display: flex; flex-direction: column; gap: .35rem; }\n.element { background: #1a2332; border-radius: 6px; padding: .4rem .6rem; font-size: .78rem; }\n.tag { color: #5B8DB8; }\n.method { background: #1a2332; border-radius: 6px; padding: .5rem .7rem; margin-bottom: .35rem; font-size: .78rem; direction: ltr; text-align: left; }\n.kbd-grid { display: flex; flex-wrap: wrap; gap: .4rem; }\n.kbd-grid span { background: #1a2332; border: 1px solid #2D3645; border-radius: 5px; padding: .3rem .5rem; font-size: .75rem; }\nkbd { background: #252D3A; border: 1px solid #475569; border-radius: 4px; padding: .05rem .3rem; font-family: monospace; font-size: .7rem; color: #D1D7E0; }\n</style>\n",

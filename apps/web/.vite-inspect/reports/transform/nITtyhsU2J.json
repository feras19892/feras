      "name": "vite:load-fallback",
      "result": "<script setup lang=\"ts\">\nimport { useI18n } from '../../../composables/useI18n'\n\nconst { t } = useI18n()\ndefineProps<{ open: boolean }>()\nconst emit = defineEmits<{ (e: 'close'): void }>()\n</script>\n\n<template>\n  <Teleport to=\"body\">\n    <div v-if=\"open\" class=\"overlay\" @click.self=\"emit('close')\">\n      <div class=\"modal\">\n        <div class=\"modal-header\">\n          <h3>📐 دليل تجربة المنحدر المائل — دليل شامل وكامل</h3>\n          <button class=\"close-btn\" @click=\"emit('close')\">&#x2715;</button>\n        </div>\n        <div class=\"modal-body\">\n\n          <!-- 1. Theoretical Background -->\n          <section>\n            <h4>� 1. المقدمة والنظرية العلمية</h4>\n            <p>\n              عند وضع جسم كتلته (<code>m</code>) على سطح مائل بزاوية (<code>θ</code>) مع الأفق،\n              فإن قوة الجاذبية (الوزن <code>W = m·g</code>) تؤثر رأسياً للأسفل.\n              لتسهيل دراسة الحركة، نقوم بتحليل قوة الوزن إلى مركبتين متعامدتين بالنسبة لسطح المنحدر:\n            </p>\n            <ul>\n              <li>\n                <b>مركبة عمودية على السطح (<code>m·g·cosθ</code>):</b>\n                تتزن مع القوة العمودية (<code>N</code>) التي يؤثر بها السطح على الجسم (<code>N = m·g·cosθ</code>).\n              </li>\n              <li>\n                <b>مركبة موازية للسطح (<code>m·g·sinθ</code>):</b>\n                وهي القوة المسؤولة عن سحب الجسم وتجعله ينزلق للأسفل.\n              </li>\n            </ul>\n            <p>إذا كان السطح خشناً، تنشأ قوة احتكاك حركي (<code>f_k</code>) تقاوم الحركة وتتجه للأعلى موازية للسطح:</p>\n            <div class=\"formula\">f_k = μ_k · N = μ_k · m · g · cos(θ)</div>\n            <p>حيث (<code>μ_k</code>) هو معامل الاحتكاك الحركي (Coefficient of Kinetic Friction).</p>\n            <p>بتطبيق قانون نيوتن الثاني على طول المنحدر (<code>ΣF = m·a</code>):</p>\n            <div class=\"formula\">\n              m·g·sinθ − f_k = m·a<br>\n              m·g·sinθ − μ_k·m·g·cosθ = m·a<br>\n              <b>a = g (sinθ − μ_k·cosθ)</b>\n            </div>\n          </section>\n\n          <!-- 2. Mathematical Equations -->\n          <section>\n            <h4>📐 2. القوانين الرياضية المستعملة</h4>\n            <div class=\"method\"><b>حالة السطح الأملس (μ_k = 0):</b> a = g·sin(θ)</div>\n            <div class=\"method\"><b>حالة السطح الخشن:</b> a = g·sin(θ) − μ_k·g·cos(θ)</div>\n            <div class=\"method\">\n              <b>معادلة الحركة لحساب التسارع عملياً (من السكون):</b><br>\n              x = ½ · a · t² &nbsp;&nbsp;→&nbsp;&nbsp; a = 2x / t²\n            </div>\n          </section>\n\n          <!-- 3. Laboratory Procedure -->\n          <section>\n            <h4>⚗️ 3. طريقة العمل في المختبر (الافتراضي)</h4>\n            <p>سنركز على السطح الأملس لتبسيط الحسابات البيانية وإيجاد تسارع الجاذبية:</p>\n            <ol>\n              <li>\n                <b>إعداد المنحدر:</b> حدد مسافة ثابتة (x) على المنحدر ليتحركها الجسم (مثلاً 1 m).\n              </li>\n              <li>\n                <b>تغيير الزاوية (θ):</b> ابدأ بزاوية ميل صغيرة (مثلاً 10°) ثم زدها تدريجياً (20°, 30°, 40°, 50°).\n              </li>\n              <li>\n                <b>القياس:</b> اترك الجسم ينزلق من السكون من أعلى المسافة المحددة وسجّل زمن وصوله (t) بواسطة المؤقت.\n              </li>\n              <li>\n                <b>حساب التسارع التجريبي:</b> لكل زاوية، احسب التسارع العملي للجسم باستخدام القانون: a = 2x / t².\n              </li>\n              <li>\n                <b>حساب الجيب:</b> احسب قيمة جيب الزاوية (sinθ) لكل زاوية استخدمتها.\n              </li>\n            </ol>\n          </section>\n\n          <!-- 4. Graphical Analysis -->\n          <section>\n            <h4>� 4. الرسم البياني، الميل، وحساب المجهول</h4>\n            <p>الهدف هنا هو حساب تسارع الجاذبية الأرضية (g) من خلال حركة المنحدر المائل.</p>\n            <ul>\n              <li>\n                <b>المحاور:</b> ارسم التسارع المحسوب (a) على المحور الصادي (Y-axis).\n                ارسم جيب زاوية الميل (sinθ) على المحور السيني (X-axis).\n              </li>\n              <li>\n                <b>الميل (Slope):</b> ستحصل على خط مستقيم يمر بنقطة الأصل، وميله يُحسب بـ:\n                <div class=\"formula\">Slope = Δa / Δsin(θ)</div>\n              </li>\n              <li>\n                <b>حساب المجهول (g):</b> بالمقارنة مع المعادلة النظرية للسطح الأملس (a = g·sinθ)، نجد أن:\n                <div class=\"formula\">Slope = g</div>\n                وبالتالي، فإن قيمة الميل الناتجة من الرسم البياني تمثل مباشرة قيمة تسارع الجاذبية الأرضية (g).\n              </li>\n            </ul>\n          </section>\n\n          <!-- 5. Variables & Constants -->\n          <section>\n            <h4>⚙️ 5. الثوابت والمتغيرات في التجربة</h4>\n            <div class=\"element-grid\">\n              <div class=\"element\">\n                <b class=\"tag\">المتغير المستقل:</b> زاوية ميل المنحدر (θ)\n              </div>\n              <div class=\"element\">\n                <b class=\"tag\">المتغيرات التابعة:</b> زمن الانزلاق (t) والتسارع (a)\n              </div>\n              <div class=\"element\">\n                <b class=\"tag\">الثوابت:</b> المسافة المقطوعة (x)، كتلة الجسم (يثبت القانون أن التسارع لا يعتمد على الكتلة)، وطبيعة السطح\n              </div>\n            </div>\n          </section>\n\n          <!-- 6. Scientific Importance -->\n          <section>\n            <h4>🎯 6. الفائدة والأهمية العلمية للتجربة</h4>\n            <ul>\n              <li>فهم كيفية تحليل القوى وتأثير زاوية الميل على تسارع الأجسام (كلما زادت الزاوية، زاد التسارع حتى يصل لقيمة g عندما تصبح الزاوية 90°).</li>\n              <li>دراسة وفهم قوى الاحتكاك وكيفية تقليلها أو الاستفادة منها.</li>\n              <li>التطبيقات العملية تشمل تصميم الطرق الجبلية الملتوية، وتصميم منحدرات الكراسي المتحركة (RAMPs) بزوايا آمنة، وفهم حركة السيارات على المرتفعات.</li>\n            </ul>\n          </section>\n\n          <!-- Keyboard shortcuts -->\n          <section>\n            <h4>⌨️ اختصارات لوحة المفاتيح</h4>\n            <div class=\"kbd-grid\">\n              <span><kbd>Space</kbd> بدء / توقف</span>\n              <span><kbd>S</kbd> تسجيل قراءة</span>\n              <span><kbd>R</kbd> إعادة التعيين</span>\n              <span><kbd>Ctrl</kbd>+<kbd>Z</kbd> تراجع</span>\n              <span><kbd>Ctrl</kbd>+<kbd>Y</kbd> إعادة</span>\n              <span><kbd>?</kbd> فتح/إغلاق المساعدة</span>\n            </div>\n          </section>\n\n        </div>\n      </div>\n    </div>\n  </Teleport>\n</template>\n\n<style scoped>\n.overlay { position: fixed; inset: 0; z-index: 300; background: rgba(0,0,0,.6); display: flex; align-items: center; justify-content: center; padding: 1.5rem; }\n.modal { background: #131a25; border: 1px solid #2D3645; border-radius: 12px; max-width: 720px; width: 100%; max-height: 90vh; display: flex; flex-direction: column; box-shadow: 0 20px 60px rgba(0,0,0,.5); }\n.modal-header { display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.2rem; border-bottom: 1px solid #2D3645; flex-shrink: 0; }\n.modal-header h3 { margin: 0; font-size: 1rem; color: #e2e8f0; }\n.close-btn { background: transparent; border: 1px solid #2D3645; color: #8B95A5; border-radius: 6px; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 1rem; padding: 0; }\n.close-btn:hover { background: rgba(91,141,184,.1); color: #5B8DB8; }\n.modal-body { overflow-y: auto; padding: 1.2rem; font-size: .82rem; color: #cbd5e1; line-height: 1.8; direction: rtl; text-align: right; }\n.modal-body section { margin-bottom: 1.4rem; }\n.modal-body h4 { margin: 0 0 .5rem; font-size: .9rem; color: #5B8DB8; border-bottom: 1px solid #2D3645; padding-bottom: .3rem; }\n.modal-body p { margin: .4rem 0; }\n.modal-body ol, .modal-body ul { margin: .4rem 0; padding-right: 1.2rem; }\n.modal-body li { margin-bottom: .25rem; }\n.formula { background: #1a2332; border: 1px solid #2D3645; border-radius: 6px; padding: .6rem .8rem; font-family: monospace; font-size: .9rem; color: #5B8DB8; text-align: center; margin: .6rem 0; direction: ltr; }\n.element-grid { display: flex; flex-direction: column; gap: .35rem; }\n.element { background: #1a2332; border-radius: 6px; padding: .4rem .6rem; font-size: .78rem; }\n.tag { color: #5B8DB8; }\n.method { background: #1a2332; border-radius: 6px; padding: .5rem .7rem; margin-bottom: .35rem; font-size: .78rem; direction: ltr; text-align: left; }\n.kbd-grid { display: flex; flex-wrap: wrap; gap: .4rem; }\n.kbd-grid span { background: #1a2332; border: 1px solid #2D3645; border-radius: 5px; padding: .3rem .5rem; font-size: .75rem; }\nkbd { background: #252D3A; border: 1px solid #475569; border-radius: 4px; padding: .05rem .3rem; font-family: monospace; font-size: .7rem; color: #D1D7E0; }\n</style>\n",

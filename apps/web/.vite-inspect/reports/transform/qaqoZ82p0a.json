      "name": "vite:load-fallback",
      "result": "<script setup lang=\"ts\">\nimport { useI18n } from '../../../composables/useI18n'\n\nconst { t } = useI18n()\ndefineProps<{ open: boolean }>()\nconst emit = defineEmits<{ (e: 'close'): void }>()\n</script>\n\n<template>\n  <Teleport to=\"body\">\n    <div v-if=\"open\" class=\"overlay\" @click.self=\"emit('close')\">\n      <div class=\"modal\">\n        <div class=\"modal-header\">\n          <h3>🪞 دليل تجربة المرايا الكروية (Spherical Mirrors) — دليل شامل وكامل</h3>\n          <button class=\"close-btn\" @click=\"emit('close')\">&#x2715;</button>\n        </div>\n        <div class=\"modal-body\">\n\n          <!-- 1. Theoretical Background -->\n          <section>\n            <h4>🔬 1. المقدمة والنظرية العلمية</h4>\n            <p>تنقسم المرايا الكروية إلى نوعين بناءً على السطح العاكس:</p>\n            <ul>\n              <li>\n                <b>المرآة المقعرة (Concave/Converging Mirror):</b>\n                يكون سطحها العاكس مقعراً للداخل. وتعمل على تجميع الأشعة المتوازية الساقطة عليها في نقطة تسمى البؤرة الحقيقية (F).\n                صفات الصور فيها تتغير (حقيقية مقلوبة، أو وهمية مكبرة) تبعاً لموقع الجسم من البؤرة.\n              </li>\n              <li>\n                <b>المرآة المحدبة (Convex/Diverging Mirror):</b>\n                يكون سطحها العاكس محدباً للخارج. وتعمل على تفريق الأشعة الساقطة عليها، وتتكون لها بؤرة وهمية (F) خلف المرآة.\n                صفات الصور فيها ثابتة دائماً (وهمية، معتدلة، مصغرة) مهما تغير موقع الجسم.\n              </li>\n            </ul>\n            <p>المبدأ الأساسي يعتمد على قانون الانعكاس (زاوية السقوط = زاوية الانعكاس) مطبقاً على السطح المنحني، حيث يرتبط بعد الجسم (u) وبعد الصورة (v) بالبعد البؤري للمرآة (f).</p>\n          </section>\n\n          <!-- 2. Mathematical Equations -->\n          <section>\n            <h4>📐 2. القوانين الرياضية المستعملة</h4>\n            <p><b>العلاقة العامة للمرايا (Mirror Equation):</b></p>\n            <div class=\"formula\">1/f = 1/u + 1/v</div>\n            <p>(حيث u هو بُعد الجسم عن قطب المرآة، v هو بُعد الصورة، و f هو البعد البؤري).</p>\n            <p><b>قاعدة الإشارات (Sign Convention):</b></p>\n            <ul>\n              <li>u دائماً موجبة للأجسام الحقيقية.</li>\n              <li>f موجبة للمرآة المقعرة، وسالبة للمرآة المحدبة.</li>\n              <li>v موجبة إذا كانت الصورة حقيقية (أمام المرآة)، وسالبة إذا كانت وهمية (خلف المرآة).</li>\n            </ul>\n            <p><b>التكبير (M — Magnification):</b></p>\n            <div class=\"formula\">M = hᵢ/hₒ = −v/u</div>\n          </section>\n\n          <!-- 3. Laboratory Procedure -->\n          <section>\n            <h4>⚗️ 3. طريقة العمل في المختبر (الافتراضي)</h4>\n            <p>سنركز على المرآة المقعرة لأنها تتيح الحصول على صور حقيقية يمكن استقبالها على شاشة:</p>\n            <ol>\n              <li>\n                <b>إعداد النظام:</b> ضع مصدر إضاءة (جسم على شكل سهم أو شمعة) أمام مرآة مقعرة ذات بعد بؤري مجهول.\n              </li>\n              <li>\n                <b>تحديد بعد الجسم (u):</b> ضع الجسم عند مسافة أولى معلومة (مثلاً u = 30 cm) بحيث تكون المسافة أكبر من البعد البؤري المتوقع.\n              </li>\n              <li>\n                <b>تحديد بعد الصورة (v):</b> حرّك الشاشة (الحائل) أمام المرآة قرباً وبعداً حتى تتكون عليها أوضح صورة حادة ومقلوبة للجسم، ثم قس المسافة من المرآة إلى الشاشة بدقة وسجّلها كـ (v).\n              </li>\n              <li>\n                <b>التكرار:</b> غيّر بعد الجسم (u) لعدة قيم مختلفة (35 cm, 40 cm, 45 cm, 50 cm)، وفي كل مرة أوجد بعد الصورة المقابل (v) وسجّل البيانات في جدول.\n              </li>\n              <li>\n                <b>مقلوب القيم:</b> احسب مقلوب بعد الجسم (1/u) ومقلوب بعد الصورة (1/v) لكل قراءة.\n              </li>\n            </ol>\n          </section>\n\n          <!-- 4. Graphical Analysis -->\n          <section>\n            <h4>📊 4. الرسم البياني، الميل، وحساب المجهول</h4>\n            <p>الهدف من الرسم البياني هو إيجاد البعد البؤري المجهول للمرآة (f).</p>\n            <ul>\n              <li>\n                <b>المحاور:</b> ارسم مقلوب بعد الصورة (1/v) على المحور الصادي (Y-axis).\n                ارسم مقلوب بعد الجسم (1/u) على المحور السيني (X-axis).\n              </li>\n              <li>\n                <b>طبيعة الرسم والميل:</b> ستحصل على خط مستقيم ينحدر للأسفل (علاقة عكسية بين مقلوب بعد الجسم ومقلوب بعد الصورة)، وميله يساوي −1:\n                <div class=\"formula\">Slope = −1</div>\n              </li>\n              <li>\n                <b>حساب المجهول (f):</b> من معادلة المرايا: 1/v = −1/u + 1/f.\n                نقطة تقاطع الخط المستقيم مع المحور الصادي (Y-intercept) وكذلك نقطة تقاطعه مع المحور السيني (X-intercept) تمثلان قيمة 1/f.\n                اقرأ نقطة التقاطع مع المحور الصادي (ولتكن قيمتها C). احسب البعد البؤري المجهول من العلاقة:\n                <div class=\"formula\">f = 1/C</div>\n              </li>\n            </ul>\n          </section>\n\n          <!-- 5. Variables & Constants -->\n          <section>\n            <h4>⚙️ 5. الثوابت والمتغيرات في التجربة</h4>\n            <div class=\"element-grid\">\n              <div class=\"element\">\n                <b class=\"tag\">المتغير المستقل:</b> بعد الجسم عن المرآة (u)\n              </div>\n              <div class=\"element\">\n                <b class=\"tag\">المتغير التابع:</b> بعد الصورة المتشكلة (v)\n              </div>\n              <div class=\"element\">\n                <b class=\"tag\">الثوابت:</b> البعد البؤري للمرآة (f)، ونصف قطر تكورها (R = 2f)، وطول الجسم الأصلي (hₒ)\n              </div>\n            </div>\n          </section>\n\n          <!-- 6. Scientific Importance -->\n          <section>\n            <h4>🎯 6. الفائدة والأهمية العلمية للتجربة</h4>\n            <ul>\n              <li>تعيين البعد البؤري ونصف قطر تكور المرايا الكروية عملياً.</li>\n              <li>فهم حالات تشكل الصور المختلفة بناءً على موقع الجسم بالنسبة لمركز التكور (C) والبؤرة (F).</li>\n              <li>التطبيقات العملية تشمل استخدام المرايا المقعرة في مصابيح السيارات الأمامية والتليسكوبات لتجميع الضوء، واستخدام المرايا المحدبة على جوانب السيارات وفي زوايا الطرق لتوفير رؤية واسعة النطاق (ميدان رؤية كبير).</li>\n            </ul>\n          </section>\n\n          <!-- Keyboard shortcuts -->\n          <section>\n            <h4>⌨️ اختصارات لوحة المفاتيح</h4>\n            <div class=\"kbd-grid\">\n              <span><kbd>Space</kbd> بدء / توقف</span>\n              <span><kbd>S</kbd> تسجيل قراءة</span>\n              <span><kbd>R</kbd> إعادة التعيين</span>\n              <span><kbd>Ctrl</kbd>+<kbd>Z</kbd> تراجع</span>\n              <span><kbd>Ctrl</kbd>+<kbd>Y</kbd> إعادة</span>\n              <span><kbd>?</kbd> فتح/إغلاق المساعدة</span>\n            </div>\n          </section>\n\n        </div>\n      </div>\n    </div>\n  </Teleport>\n</template>\n\n<style scoped>\n.overlay { position: fixed; inset: 0; z-index: 300; background: rgba(0,0,0,.6); display: flex; align-items: center; justify-content: center; padding: 1.5rem; }\n.modal { background: #131a25; border: 1px solid #2D3645; border-radius: 12px; max-width: 720px; width: 100%; max-height: 90vh; display: flex; flex-direction: column; box-shadow: 0 20px 60px rgba(0,0,0,.5); }\n.modal-header { display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.2rem; border-bottom: 1px solid #2D3645; flex-shrink: 0; }\n.modal-header h3 { margin: 0; font-size: 1rem; color: #e2e8f0; }\n.close-btn { background: transparent; border: 1px solid #2D3645; color: #8B95A5; border-radius: 6px; width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 1rem; padding: 0; }\n.close-btn:hover { background: rgba(91,141,184,.1); color: #5B8DB8; }\n.modal-body { overflow-y: auto; padding: 1.2rem; font-size: .82rem; color: #cbd5e1; line-height: 1.8; direction: rtl; text-align: right; }\n.modal-body section { margin-bottom: 1.4rem; }\n.modal-body h4 { margin: 0 0 .5rem; font-size: .9rem; color: #5B8DB8; border-bottom: 1px solid #2D3645; padding-bottom: .3rem; }\n.modal-body p { margin: .4rem 0; }\n.modal-body ol, .modal-body ul { margin: .4rem 0; padding-right: 1.2rem; }\n.modal-body li { margin-bottom: .25rem; }\n.formula { background: #1a2332; border: 1px solid #2D3645; border-radius: 6px; padding: .6rem .8rem; font-family: monospace; font-size: .9rem; color: #5B8DB8; text-align: center; margin: .6rem 0; direction: ltr; }\n.element-grid { display: flex; flex-direction: column; gap: .35rem; }\n.element { background: #1a2332; border-radius: 6px; padding: .4rem .6rem; font-size: .78rem; }\n.tag { color: #5B8DB8; }\n.kbd-grid { display: flex; flex-wrap: wrap; gap: .4rem; }\n.kbd-grid span { background: #1a2332; border: 1px solid #2D3645; border-radius: 5px; padding: .3rem .5rem; font-size: .75rem; }\nkbd { background: #252D3A; border: 1px solid #475569; border-radius: 4px; padding: .05rem .3rem; font-family: monospace; font-size: .7rem; color: #D1D7E0; }\n</style>\n",

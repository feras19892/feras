        "sourcesContent": [
          "<script setup lang=\"ts\">\r\nimport { computed, ref } from 'vue';\r\n\r\ninterface Props {\r\n  volume?: number;     // 0–10 mL drawn\r\n  maxVolume?: number;  // 10\r\n  liquidColor?: string;\r\n  liquidOpacity?: number;\r\n  isHovered?: boolean;\r\n  isActive?: boolean;  // true when in cursor mode\r\n  scale?: number;\r\n  isSelected?: boolean;\r\n}\r\n\r\nconst props = withDefaults(defineProps<Props>(), {\r\n  volume: 0,\r\n  maxVolume: 10,\r\n  liquidColor: '#3b82f6',\r\n  liquidOpacity: 0.35,\r\n  isHovered: false,\r\n  isActive: false,\r\n  scale: 1,\r\n  isSelected: false,\r\n});\r\n\r\nconst emit = defineEmits<{ click: []; }>();\r\n\r\n/* Geometry: rubber bulb at top, graduated tube, fine tip */\r\nconst tubeBottom = 210; // where tube meets tip\r\nconst tubeTop = 55;     // where tube meets neck\r\nconst tubeH = tubeBottom - tubeTop; // 155px = 10mL\r\n\r\n/* Liquid fills tube from bottom up */\r\nconst liquidH = computed(() => {\r\n  if (props.volume <= 0) return 0;\r\n  return (props.volume / props.maxVolume) * tubeH;\r\n});\r\nconst liquidY = computed(() => tubeBottom - liquidH.value);\r\nconst liquidTop = computed(() => liquidY.value);\r\n\r\n/* Graduation marks: 0 at tubeBottom, 10 at tubeTop */\r\nconst marks = computed(() => {\r\n  const m: { y: number; val: number; showLabel: boolean }[] = [];\r\n  for (let i = 0; i <= 10; i++) {\r\n    m.push({ y: tubeBottom - (i / 10) * tubeH, val: i, showLabel: i % 5 === 0 });\r\n  }\r\n  return m;\r\n});\r\n\r\n/* Canvas for drop effect when emptying */\r\nconst canvasRef = ref<HTMLCanvasElement | null>(null);\r\n</script>\r\n\r\n<template>\r\n  <div class=\"pipette-wrapper\" :class=\"{ active: isActive }\" @click.stop=\"emit('click')\" data-v-inspector=\"src/components/experiment/chemistry/LabPipette.vue:55:3\">\r\n    <svg\r\n      viewBox=\"0 0 60 280\"\r\n      class=\"pipette-svg\"\r\n      :class=\"{ hovered: isHovered }\"\r\n      :style=\"{ width: 50 * props.scale + 'px', height: 230 * props.scale + 'px' }\" data-v-inspector=\"src/components/experiment/chemistry/LabPipette.vue:56:5\"\r\n    >\r\n      <!-- Shadow -->\r\n      <ellipse cx=\"30\" cy=\"275\" rx=\"4\" ry=\"1\" fill=\"rgba(0,0,0,0.06)\" data-v-inspector=\"src/components/experiment/chemistry/LabPipette.vue:63:7\" />\r\n\r\n      <!-- Fine tip (tapered cone) -->\r\n      <path\r\n        d=\"M 27 210 L 29 262 L 31 262 L 33 210 Z\"\r\n        fill=\"rgba(241,245,249,0.3)\"\r\n        stroke=\"#94a3b8\"\r\n        stroke-width=\"0.8\" data-v-inspector=\"src/components/experiment/chemistry/LabPipette.vue:66:7\"\r\n      />\r\n\r\n      <!-- Graduated tube -->\r\n      <rect x=\"27\" y=\"55\" width=\"6\" height=\"155\" rx=\"1\"\r\n        fill=\"rgba(241,245,249,0.15)\"\r\n        stroke=\"#94a3b8\"\r\n        stroke-width=\"0.8\" data-v-inspector=\"src/components/experiment/chemistry/LabPipette.vue:74:7\"\r\n      />\r\n      <!-- Selection outline -->\r\n      <rect\r\n        v-if=\"isSelected\"\r\n        x=\"25\"\r\n        y=\"48\"\r\n        width=\"10\"\r\n        height=\"167\"\r\n        rx=\"2\"\r\n        fill=\"none\"\r\n        stroke=\"#10b981\"\r\n        stroke-width=\"1.8\"\r\n        opacity=\"0.9\" data-v-inspector=\"src/components/experiment/chemistry/LabPipette.vue:80:7\"\r\n      />\r\n\r\n      <!-- Neck connector -->\r\n      <rect x=\"26\" y=\"48\" width=\"8\" height=\"7\" rx=\"1\"\r\n        fill=\"rgba(241,245,249,0.2)\"\r\n        stroke=\"#94a3b8\"\r\n        stroke-width=\"0.8\" data-v-inspector=\"src/components/experiment/chemistry/LabPipette.vue:94:7\"\r\n      />\r\n\r\n      <!-- Rubber bulb at top -->\r\n      <ellipse cx=\"30\" cy=\"22\" rx=\"13\" ry=\"18\"\r\n        fill=\"rgba(220,38,38,0.15)\"\r\n        stroke=\"#dc2626\"\r\n        stroke-width=\"1\" data-v-inspector=\"src/components/experiment/chemistry/LabPipette.vue:101:7\"\r\n      />\r\n      <!-- Bulb highlight -->\r\n      <ellipse cx=\"25\" cy=\"16\" rx=\"5\" ry=\"8\"\r\n        fill=\"none\"\r\n        stroke=\"rgba(255,255,255,0.3)\"\r\n        stroke-width=\"1\" data-v-inspector=\"src/components/experiment/chemistry/LabPipette.vue:107:7\"\r\n      />\r\n\r\n      <!-- Graduation marks -->\r\n      <g v-for=\"(mark, idx) in marks\" :key=\"idx\" data-v-inspector=\"src/components/experiment/chemistry/LabPipette.vue:114:7\">\r\n        <line\r\n          :x1=\"30\"\r\n          :y1=\"mark.y\"\r\n          :x2=\"mark.showLabel ? 36 : 33\"\r\n          :y2=\"mark.y\"\r\n          :stroke=\"mark.showLabel ? '#334155' : '#94a3b8'\"\r\n          :stroke-width=\"mark.showLabel ? 0.8 : 0.5\"\r\n          :opacity=\"mark.showLabel ? 0.7 : 0.4\"\r\n          stroke-linecap=\"round\" data-v-inspector=\"src/components/experiment/chemistry/LabPipette.vue:115:9\"\r\n        />\r\n        <text\r\n          v-if=\"mark.showLabel\"\r\n          :x=\"38\"\r\n          :y=\"mark.y + 2\"\r\n          font-size=\"5\"\r\n          fill=\"#334155\"\r\n          font-weight=\"700\"\r\n          opacity=\"0.7\" data-v-inspector=\"src/components/experiment/chemistry/LabPipette.vue:125:9\"\r\n        >{{ mark.val }}</text>\r\n      </g>\r\n\r\n      <!-- LIQUID in graduated tube -->\r\n      <g v-if=\"volume > 0\" data-v-inspector=\"src/components/experiment/chemistry/LabPipette.vue:137:7\">\r\n        <rect\r\n          :x=\"28\"\r\n          :y=\"liquidTop\"\r\n          :width=\"4\"\r\n          :height=\"liquidH\"\r\n          :fill=\"liquidColor\"\r\n          :opacity=\"liquidOpacity\"\r\n          rx=\"1\" data-v-inspector=\"src/components/experiment/chemistry/LabPipette.vue:138:9\"\r\n        />\r\n        <!-- Meniscus -->\r\n        <ellipse\r\n          :cx=\"30\"\r\n          :cy=\"liquidTop\"\r\n          :rx=\"2.5\"\r\n          ry=\"1\"\r\n          :fill=\"liquidColor\"\r\n          :opacity=\"liquidOpacity + 0.15\" data-v-inspector=\"src/components/experiment/chemistry/LabPipette.vue:148:9\"\r\n        />\r\n        <!-- Highlight on liquid surface -->\r\n        <ellipse\r\n          :cx=\"30\"\r\n          :cy=\"liquidTop + 0.5\"\r\n          :rx=\"1.5\"\r\n          ry=\"0.5\"\r\n          fill=\"rgba(255,255,255,0.5)\" data-v-inspector=\"src/components/experiment/chemistry/LabPipette.vue:157:9\"\r\n        />\r\n        <!-- Volume number inside tube -->\r\n        <text\r\n          x=\"30\"\r\n          :y=\"liquidTop - 6\"\r\n          font-size=\"7\"\r\n          font-weight=\"800\"\r\n          :fill=\"liquidColor\"\r\n          text-anchor=\"middle\"\r\n          opacity=\"0.9\" data-v-inspector=\"src/components/experiment/chemistry/LabPipette.vue:165:9\"\r\n        >{{ volume.toFixed(1) }}</text>\r\n      </g>\r\n\r\n      <!-- Glass highlights -->\r\n      <path d=\"M 28 65 L 28 200\" stroke=\"rgba(255,255,255,0.25)\" stroke-width=\"1\" stroke-linecap=\"round\" fill=\"none\" data-v-inspector=\"src/components/experiment/chemistry/LabPipette.vue:177:7\" />\r\n      <path d=\"M 26 15 Q 23 22 26 30\" stroke=\"rgba(255,255,255,0.2)\" stroke-width=\"1\" stroke-linecap=\"round\" fill=\"none\" data-v-inspector=\"src/components/experiment/chemistry/LabPipette.vue:178:7\" />\r\n    </svg>\r\n\r\n    <!-- Drop canvas (only when emptying animation active) -->\r\n    <canvas\r\n      ref=\"canvasRef\"\r\n      width=\"60\"\r\n      height=\"280\"\r\n      class=\"drop-canvas\" data-v-inspector=\"src/components/experiment/chemistry/LabPipette.vue:182:5\"\r\n    />\r\n  </div>\r\n</template>\r\n\r\n<style scoped>\r\n.pipette-wrapper {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  position: relative;\r\n  cursor: pointer;\r\n}\r\n.pipette-wrapper.active {\r\n  filter: drop-shadow(0 0 12px rgba(16,185,129,0.4));\r\n}\r\n.pipette-svg.hovered {\r\n  filter: brightness(1.04);\r\n}\r\n.drop-canvas {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 50%;\r\n  width: 60px;\r\n  height: 280px;\r\n  margin-left: -30px;\r\n  z-index: 2;\r\n  pointer-events: none;\r\n}\r\n</style>\r\n"
        ]

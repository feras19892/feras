{
  "name": "@my-modern-app/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "node ../../node_modules/vite/bin/vite.js",
    "diagnose": "node ../../node_modules/vue-tsc/bin/vue-tsc.js --noEmit && node ../../node_modules/eslint/bin/eslint.js . --ext .vue,.ts,.tsx && node ../../node_modules/vitest/vitest.mjs run src/composables/fuzz-physics-engines.test.ts src/composables/property-physics.test.ts",
    "build": "pnpm run diagnose && node ../../node_modules/vite/bin/vite.js build",
    "preview": "node ../../node_modules/vite/bin/vite.js preview",
    "lint": "node ../../node_modules/eslint/bin/eslint.js . --ext .vue,.ts,.tsx",
    "lint:fix": "node ../../node_modules/eslint/bin/eslint.js . --ext .vue,.ts,.tsx --fix",
    "typecheck": "node ../../node_modules/vue-tsc/bin/vue-tsc.js --noEmit",
    "test": "node ../../node_modules/vitest/vitest.mjs run",
    "test:ui": "node ../../node_modules/vitest/vitest.mjs --ui",
    "test:fuzz": "node ../../node_modules/vitest/vitest.mjs run src/composables/fuzz-physics-engines.test.ts src/composables/chemistry/fuzz-chemistry.test.ts",
    "test:property": "node ../../node_modules/vitest/vitest.mjs run src/composables/property-physics.test.ts src/composables/chemistry/property-chemistry.test.ts",
    "test:fuzz:physics": "node ../../node_modules/vitest/vitest.mjs run src/composables/fuzz-physics-engines.test.ts",
    "test:fuzz:chemistry": "node ../../node_modules/vitest/vitest.mjs run src/composables/chemistry/fuzz-chemistry.test.ts",
    "test:property:physics": "node ../../node_modules/vitest/vitest.mjs run src/composables/property-physics.test.ts",
    "test:property:chemistry": "node ../../node_modules/vitest/vitest.mjs run src/composables/chemistry/property-chemistry.test.ts",
    "test:e2e": "node ../../node_modules/@playwright/test/cli.js test",
    "test:e2e:visual": "node ../../node_modules/@playwright/test/cli.js test tests/visual-regression.spec.ts --update-snapshots",
    "test:e2e:perf": "node ../../node_modules/@playwright/test/cli.js test tests/performance-leak.spec.ts --headed",
    "test:e2e:monkey": "node ../../node_modules/@playwright/test/cli.js test tests/monkey-tabs.spec.ts",
    "test:all": "pnpm run typecheck && pnpm run lint && pnpm run test:fuzz && pnpm run test:property && pnpm run test:e2e",
    "inspect": "node ../../node_modules/vite/bin/vite.js --inspect"
  },
  "dependencies": {
    "@box2d/core": "^0.11.0",
    "@box2d/particles": "^0.11.0",
    "@my-modern-app/chemistry-engine": "workspace:*",

{
  "name": "@my-modern-app/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.ts,.tsx",
    "lint:fix": "eslint . --ext .vue,.ts,.tsx --fix",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:fuzz": "vitest run src/composables/fuzz-physics-engines.test.ts",
    "test:property": "vitest run src/composables/property-physics.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:visual": "playwright test tests/visual-regression.spec.ts --update-snapshots",
    "test:e2e:perf": "playwright test tests/performance-leak.spec.ts --headed",
    "test:e2e:monkey": "playwright test tests/monkey-tabs.spec.ts",
    "test:all": "pnpm run typecheck && pnpm run lint && pnpm run test:fuzz && pnpm run test:property && pnpm run test:e2e"
  },
  "dependencies": {
    "@my-modern-app/shared-types": "workspace:*",
    "@types/three": "^0.184.1",
    "pinia": "^2.1.0",
    "splitpanes": "^4.1.2",
    "three": "^0.184.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@my-modern-app/config": "workspace:*",
    "@playwright/test": "^1.61.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "@vitest/ui": "^2.1.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.0.0",
    "fast-check": "^4.8.0",
    "jsdom": "^24.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^2.1.0",
    "vue-eslint-parser": "^9.4.0",
    "vue-tsc": "^2.0.0"
  }
}

{
  "name": "@my-modern-app/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "pnpm exec vite",
    "diagnose": "pnpm exec vue-tsc --noEmit && pnpm exec eslint . --ext .vue,.ts,.tsx && pnpm exec vitest run src/composables/fuzz-physics-engines.test.ts src/composables/property-physics.test.ts",
    "build": "pnpm run diagnose && pnpm exec vite build",
    "preview": "pnpm exec vite preview",
    "lint": "pnpm exec eslint . --ext .vue,.ts,.tsx",
    "lint:fix": "pnpm exec eslint . --ext .vue,.ts,.tsx --fix",
    "typecheck": "pnpm exec vue-tsc --noEmit",
    "test": "pnpm exec vitest run",
    "test:ui": "pnpm exec vitest --ui",
    "test:fuzz": "pnpm exec vitest run src/composables/fuzz-physics-engines.test.ts src/composables/chemistry/fuzz-chemistry.test.ts",
    "test:property": "pnpm exec vitest run src/composables/property-physics.test.ts src/composables/chemistry/property-chemistry.test.ts",
    "test:fuzz:physics": "pnpm exec vitest run src/composables/fuzz-physics-engines.test.ts",
    "test:fuzz:chemistry": "pnpm exec vitest run src/composables/chemistry/fuzz-chemistry.test.ts",
    "test:property:physics": "pnpm exec vitest run src/composables/property-physics.test.ts",
    "test:property:chemistry": "pnpm exec vitest run src/composables/chemistry/property-chemistry.test.ts",
    "test:e2e": "pnpm exec playwright test",
    "test:e2e:visual": "pnpm exec playwright test tests/visual-regression.spec.ts --update-snapshots",
    "test:e2e:perf": "pnpm exec playwright test tests/performance-leak.spec.ts --headed",
    "test:e2e:monkey": "pnpm exec playwright test tests/monkey-tabs.spec.ts",
    "test:all": "pnpm run typecheck && pnpm run lint && pnpm run test:fuzz && pnpm run test:property && pnpm run test:e2e",
    "inspect": "pnpm exec vite --inspect",
    "agent": "pnpm exec tsx e2e/ai-agent/agent.ts"
  },
  "dependencies": {
    "@box2d/core": "^0.11.0",
    "@box2d/particles": "^0.11.0",
    "@my-modern-app/chemistry-engine": "workspace:*",
    "@my-modern-app/math-engine": "workspace:*",
    "@my-modern-app/shared-types": "workspace:*",
    "@sentry/vue": "^8.0.0",
    "@tresjs/core": "^5.8.3",
    "@types/katex": "^0.16.8",
    "@types/matter-js": "^0.20.2",
    "@types/three": "^0.184.1",
    "chart.js": "^4.5.1",
    "katex": "^0.17.0",
    "liquidfun-emscripten": "^1.1.4",
    "lucide-vue-next": "^1.0.0",
    "matter-js": "^0.20.0",
    "mitt": "^3.0.1",
    "pinia": "^2.1.0",
    "pixi.js": "^8.19.0",
    "splitpanes": "^4.1.2",
    "three": "^0.184.0",
    "vue": "^3.4.0",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^4.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@browserbasehq/stagehand": "^4.0.2",
    "@my-modern-app/config": "workspace:*",
    "@playwright/test": "^1.61.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^2.1.0",
    "@vitest/ui": "^2.1.0",
    "dotenv": "16.4.7",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.0.0",
    "fast-check": "^4.8.0",
    "jsdom": "^24.0.0",
    "terser": "^5.51.0",
    "typescript": "^5.4.0",
    "vite": "^8.2.0",
    "vite-plugin-inspect": "^0.8.9",
    "vite-plugin-vue-devtools": "^7.7.0",
    "vitest": "^2.1.0",
    "vue-eslint-parser": "^9.4.0",
    "vue-tsc": "^2.0.0"
  }
}

    "@types/matter-js": "^0.20.2",
    "@types/three": "^0.184.1",
    "liquidfun-emscripten": "^1.1.4",
    "matter-js": "^0.20.0",
    "@sentry/vue": "^8.0.0",
    "pinia": "^2.1.0",
    "pixi.js": "^8.19.0",
    "splitpanes": "^4.1.2",
    "three": "^0.184.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@my-modern-app/config": "workspace:*",
    "@playwright/test": "^1.61.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^2.1.0",
    "@vitest/ui": "^2.1.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.0.0",
    "fast-check": "^4.8.0",
    "jsdom": "^24.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.0",
    "vue-eslint-parser": "^9.4.0",
    "vite-plugin-inspect": "^0.8.9",
    "vite-plugin-vue-devtools": "^7.7.0",
    "vue-tsc": "^2.0.0"
  }
}

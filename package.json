{
  "name": "my-modern-app",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "start": "node node_modules/turbo/bin/turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && node toolbox/scripts/clean.js",
    "gen": "node toolbox/generators/index.js"
  },
  "devDependencies": {
    "turbo": "^2.10.8",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  }
}
